# ==============================================================================
# KOMMUNE AI GUARDRAILS — MILJØVARIABLER (.env.example)
# Kopier denne filen til .env og fyll inn dine verdier:
# cp .env.example .env
# ==============================================================================

# 1. Google Gemini API (Anbefalt for lynrask respons og 0 % lokal CPU-last)
# Hent nøkkel gratis på: https://aistudio.google.com/
GEMINI_API_KEY=ditt_gemini_api_token_her

# 2. Alternativ lokal Ollama (For 100 % frakoblet/air-gapped drift)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# 3. Databasestier
KOMMUNE_DB_PATH=erp_data/kommune_golden_record.db
RAG_DB_PATH=kommune-ai-guardrails/data/processed/kristiansand_legal_db.sqlite

# 4. Streamlit Serverinnstillinger
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=false
