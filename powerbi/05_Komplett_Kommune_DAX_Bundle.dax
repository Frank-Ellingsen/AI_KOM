//
// VAR UserUnits = 
//     CALCULATETABLE(
//         VALUES(Dim_Sikkerhet_RLS[ansvar_kode]),
//         Dim_Sikkerhet_RLS[bruker_upn] == CurrentUser
//     )
//
// VAR UserSectors = 
//     CALCULATETABLE(
//         VALUES(Dim_Sikkerhet_RLS[kommunalsjefomrade]),
//         Dim_Sikkerhet_RLS[bruker_upn] == CurrentUser,
//         Dim_Sikkerhet_RLS[niva] IN { "NIVA1", "NIVA1_KOMMUNALSJEF" }
//     )
//
// RETURN
//     IF(
//         IsControllerAdmin,
//         TRUE(), -- Frank Ellingsen og toppledelse har 100 % bypass (Showcase / Controller)
//         Dim_Ansvar[ansvar_kode] IN UserUnits
//         ||
//         Dim_Ansvar[kommunalsjefomrade] IN UserSectors
//     )
//
// Statiske testroller i Power BI Desktop (Modeling -> View as):
// - Controller_Admin: Dim_Ansvar = TRUE()
// - Kommunalsjef_Oppvekst: Dim_Ansvar[kommunalsjefomrade] = "Oppvekst"
// - Kommunalsjef_Helse: Dim_Ansvar[kommunalsjefomrade] = "Helse og mestring"
// - Enhetsleder_Skole: Dim_Ansvar[ansvar_kode] = "2020"
// - Enhetsleder_Boenhet: Dim_Ansvar[ansvar_kode] = "2540"
