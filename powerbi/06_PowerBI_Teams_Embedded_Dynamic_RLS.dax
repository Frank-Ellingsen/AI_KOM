// ==============================================================================
// 🏛️ KRISTIANSAND KOMMUNE — POWER BI FOR MICROSOFT TEAMS (DYNAMIC RLS)
// Modul: Dynamic Row-Level Security (RLS) for Budsjettansvarlige (Nivå 1–4)
// Arkitektur: Azure AD / Microsoft 365 SSO -> USERPRINCIPALNAME() -> Star Schema
// Hjemmel: Kommuneloven § 13-1 (Delegering), § 14-5 (Budsjettbalanse) & GDPR Art. 5
// Fagansvarlig: Frank Ellingsen (Senior Financial Controller & Project Controller)
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. DATA MODEL ARCHITECTURE FOR TEAMS EMBEDDED RLS
// ------------------------------------------------------------------------------
// For at Power BI Embedded i Microsoft Teams skal filtrere automatisk per innlogget leder,
// benyttes en dedikert sikkerhets- og organisasjonsdimensjon:
// 
//   Dim_Budsjettansvarlige (Sikkerhetsbro / Delegeringskatalog)
//   ├── Ansvar_ID        (PK: f.eks. "5200-ENH-401", "4100-ENH-202")
//   ├── Enhet_Navn       (f.eks. "Strai Sykehjem", "Lovisenlev Skole")
//   ├── Leder_Navn       (f.eks. "Solveig Grimstad", "Trond Jensen")
//   ├── Leder_Epost      (UPN: "solveig.grimstad@kristiansand.kommune.no")
//   ├── Sektor_Kode      (f.eks. "5000-HELSE", "4000-OPPV", "3000-BYUTV")
//   ├── Sektor_Navn      (f.eks. "Helse og mestring", "Oppvekst og utdanning")
//   ├── Niva             (1 = Toppledelse, 2 = Område, 3 = Enhet, 4 = Avdeling)
//   └── Rolle            ("ENHETSLEDER", "SEKTORSJEF", "CONTROLLER", "TOPPLEDELSE")
//
// Relasjoner (1:* med bi-directional filtering eller single-direction fra Dim til Fact):
//   Dim_Budsjettansvarlige[Ansvar_ID] 1 ─── * Fact_Transaksjoner[Ansvar_ID]
//   Dim_Budsjettansvarlige[Ansvar_ID] 1 ─── * Fact_Budsjett[Ansvar_ID]
// ------------------------------------------------------------------------------

// ------------------------------------------------------------------------------
// 2. PRIMÆR RLS REGEL (Legges på tabellen: Dim_Budsjettansvarlige)
// ------------------------------------------------------------------------------
// I Power BI Desktop -> Modeling -> Manage Roles:
// Opprett rolle: "RLS_Budsjettansvarlig_Teams"
// Tabellfilter for Dim_Budsjettansvarlige:

[RLS_Filter_Teams_Dynamic] = 
VAR CurrentUserEmail = LOWER(USERPRINCIPALNAME())

// Finn innlogget brukers rolle og tilhørighet fra sikkerhetstabellen:
VAR UserRow = 
    FILTER(
        Dim_Budsjettansvarlige,
        LOWER(Dim_Budsjettansvarlige[Leder_Epost]) = CurrentUserEmail
    )

VAR UserRole = 
    MAXX(UserRow, Dim_Budsjettansvarlige[Rolle])

VAR UserSector = 
    MAXX(UserRow, Dim_Budsjettansvarlige[Sektor_Kode])

VAR UserUnit = 
    MAXX(UserRow, Dim_Budsjettansvarlige[Ansvar_ID])

RETURN
    SWITCH(
        TRUE(),
        
        // ----------------------------------------------------------------------
        // NIVÅ A: KONSENRCONTROLLER & TOPPLEDELSE (Fullt innsyn: 7.24 mrd NOK)
        // Brukere: Camilla Dunsæd (Komm.dir), Frank Ellingsen (Sr Controller), 
        // Terje Fjellvang (Økonomidir), Kommunerevisjonen
        // ----------------------------------------------------------------------
        UserRole IN {"CONTROLLER", "TOPPLEDELSE", "REVISJON"},
        TRUE(),
        
        // ----------------------------------------------------------------------
        // NIVÅ B: KOMMUNALSJEFER (Nivå 1 Sektorramme: f.eks. Helse 1.4 mrd NOK)
        // Brukere: Brede Skeie (Helse), Kristin Robstad (Oppvekst), Ragnar Evensen (Byutv)
        // Ser samtlige enheter underlagt eget virksomhetsområde
        // ----------------------------------------------------------------------
        UserRole = "SEKTORSJEF",
        [Sektor_Kode] = UserSector,
        
        // ----------------------------------------------------------------------
        // NIVÅ C: OMRÅDELEDERE (Nivå 2 Portefølje: f.eks. Skolesjef, VA-sjef)
        // Brukere: Svein Tore Kvernes (Skoler), Mette Syvertsen (Sykehjem)
        // Ser alle enheter innenfor sitt funksjonsområde
        // ----------------------------------------------------------------------
        UserRole = "OMRADELEDER",
        [Omraade_Kode] = MAXX(UserRow, Dim_Budsjettansvarlige[Omraade_Kode]),
        
        // ----------------------------------------------------------------------
        // NIVÅ D: ENHETSLEDERE & REKTORER (Nivå 3: 1–3 MNOK driftsramme)
        // Brukere: Solveig Grimstad (Strai), Trond Jensen (Lovisenlev Skole),
        // Hans Petter Vik (Byggesak), Camilla Jarlsby (Kultur)
        // Ser KUN sin egen enhet / KOSTRA-ansvar! Andre enheter filtreres 100 % ut.
        // ----------------------------------------------------------------------
        UserRole = "ENHETSLEDER",
        [Ansvar_ID] = UserUnit,
        
        // ----------------------------------------------------------------------
        // STANDARD SIKKERHETSSPERRE (Zero Trust fallback):
        // Uautoriserte eller eksterne kontoer returnerer tomt datasett
        // ----------------------------------------------------------------------
        FALSE()
    )


// ------------------------------------------------------------------------------
// 3. HJELPEMÅL (DAX MEASURES) FOR TEAMS HEADER & SIKKERHETSKONTEKST
// ------------------------------------------------------------------------------

// Viser hvem som er innlogget og hvilket autorisasjonsnivå de har i Teams-fanen:
[Teams_Aktiv_Leder_Tittel] = 
VAR CurrentEmail = LOWER(USERPRINCIPALNAME())
VAR LeaderName = 
    LOOKUPVALUE(
        Dim_Budsjettansvarlige[Leder_Navn],
        Dim_Budsjettansvarlige[Leder_Epost], CurrentEmail,
        "Ekstern / Udefinert bruker"
    )
VAR UnitName = 
    LOOKUPVALUE(
        Dim_Budsjettansvarlige[Enhet_Navn],
        Dim_Budsjettansvarlige[Leder_Epost], CurrentEmail,
        "Konserninnsyn"
    )
VAR RoleLevel = 
    LOOKUPVALUE(
        Dim_Budsjettansvarlige[Rolle],
        Dim_Budsjettansvarlige[Leder_Epost], CurrentEmail,
        "Ingen tilgang"
    )
RETURN
    LeaderName & " (" & RoleLevel & " — " & UnitName & ")"


// Mål som beregner synlig ramme tilpasset RLS-scopet:
[Synlig_Aarsramme_BAC] = 
CALCULATE(
    SUM(Fact_Budsjett[Vedtatt_Aarsbudsjett_BAC]),
    // RLS filtrerer automatisk Dim_Budsjettansvarlige som propagerer til Fact
    KEEPFILTERS(Dim_Budsjettansvarlige)
)

[Synlig_Forbruk_Hittil_AC] = 
CALCULATE(
    SUM(Fact_Transaksjoner[Faktisk_Beloep_AC]),
    KEEPFILTERS(Dim_Budsjettansvarlige)
)

[Synlig_Rest_Disponibel_Saldo] = 
[Synlig_Aarsramme_BAC] - [Synlig_Forbruk_Hittil_AC]

[Synlig_Forbruksgrad_Pct] = 
DIVIDE([Synlig_Forbruk_Hittil_AC], [Synlig_Aarsramme_BAC], 0)


// Dynamisk banner tilpasset Teams-visningen:
[Teams_Leder_Sikkerhetsstatus_Tekst] = 
VAR CurrentEmail = LOWER(USERPRINCIPALNAME())
VAR UserRole = LOOKUPVALUE(Dim_Budsjettansvarlige[Rolle], Dim_Budsjettansvarlige[Leder_Epost], CurrentEmail, "UKJENT")
RETURN
    SWITCH(
        UserRole,
        "ENHETSLEDER", "🔒 RLS Aktiv: Du har enhetsinnsyn jf. delegert fullmakt. Øvrige kommunale enheter er skjermet.",
        "SEKTORSJEF", "🏛️ RLS Sektor: Du ser samtlige underlagte enheter i din sektor.",
        "CONTROLLER", "🌐 RLS Konsern: Fullstendig analytisk innsyn på tvers av alle 81 enheter og 7.24 mrd kr.",
        "TOPPLEDELSE", "👑 Toppledelsesinnsyn: Aggregert og detaljert oversikt over hele kommunens økonomi.",
        "⚠️ Uautorisert tilgang: Ingen gyldig budsjettfullmakt funnet for denne Microsoft 365-brukerkontoen."
    )


