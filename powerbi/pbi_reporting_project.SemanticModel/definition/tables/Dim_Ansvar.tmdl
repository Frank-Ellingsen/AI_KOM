table Dim_Ansvar

	column ansvar_kode
		dataType: string
		summarizeBy: none
		sourceColumn: ansvar_kode

	column ansvar_navn
		dataType: string
		summarizeBy: none
		sourceColumn: ansvar_navn

	column kommunalsjefomrade
		dataType: string
		summarizeBy: none
		sourceColumn: kommunalsjefomrade

	partition Dim_Ansvar = m
		mode: import
		source =
				let
				    SourceFact = Fact_Regnskap,
				    FactCols = Table.SelectColumns(SourceFact, {"ansvar_kode", "ansvar_navn", "kommunalsjefomrade"}),
				    SourceSec = Csv.Document(File.Contents(DataRoot & "Dim_Sikkerhet_RLS.csv"), [Delimiter=";", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    SecHeaders = Table.PromoteHeaders(SourceSec, [PromoteAllScalars=true]),
				    SecFiltered = Table.SelectRows(SecHeaders, each [ansvar_kode] <> "ALL"),
				    SecCols = Table.SelectColumns(SecFiltered, {"ansvar_kode", "enhet_navn", "kommunalsjefomrade"}),
				    SecRenamed = Table.RenameColumns(SecCols, {{"enhet_navn", "ansvar_navn"}}),
				    Combined = Table.Combine({FactCols, SecRenamed}),
				    Unique = Table.Distinct(Combined, {"ansvar_kode"})
				in
				    Unique

	annotation PBI_ResultType = Table
