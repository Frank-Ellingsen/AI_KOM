	partition Fact_Regnskap = m
		mode: import
		source =
				let
				    // Skole data
				    SourceSkole = Csv.Document(File.Contents(DataRoot & "Visma_ERP_General_Ledger_Transactions.csv"), [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    HeadersSkole = Table.PromoteHeaders(SourceSkole, [PromoteAllScalars=true]),
				    TypeSkole = Table.TransformColumnTypes(HeadersSkole, {
				        {"dato", type date}, {"Måned_Nr", Int64.Type}, {"Måned", type text}, {"Tertial", type text},
				        {"Status", type text}, {"KOSTRA_Funksjon", type text}, {"KOSTRA_Art", type text},
				        {"Kontokode", type text}, {"Kontonavn", type text}, {"Hovedgruppe", type text},
				        {"Undergruppe", type text}, {"Budsjett", type number}, {"Regnskap", type number}, {"Avvik", type number}
				    }, "en-US"),
				    AddMerforbrukSkole = Table.AddColumn(TypeSkole, "Merforbruk", each if [Avvik] < 0 then -[Avvik] else 0, type number),
				    AddRespCodeSkole = Table.AddColumn(AddMerforbrukSkole, "ansvar_kode", each "2020", type text),
				    AddRespNameSkole = Table.AddColumn(AddRespCodeSkole, "ansvar_navn", each "Grunnskole Enhet 2020", type text),
				    AddFunkSkole = Table.AddColumn(AddRespNameSkole, "funksjon_kode", each Text.From([KOSTRA_Funksjon]), type text),
				    AddSektorSkole = Table.AddColumn(AddFunkSkole, "kommunalsjefomrade", each "Oppvekst", type text),
				    AddArtKeySkole = Table.AddColumn(AddSektorSkole, "art_key", each Text.From([KOSTRA_Art]) & "|" & Text.From([Kontokode]) & "|" & Text.From([Kontonavn]), type text),
				    AddAnnualBudgetSkole = Table.AddColumn(AddArtKeySkole, "Aarsbudsjett", each [Budsjett] * 1.5, type number),
				    RenameSkole = Table.RenameColumns(AddAnnualBudgetSkole, {{"Måned_Nr", "maned"}, {"Måned", "manedsnavn"}}),
				    ColsSkole = Table.SelectColumns(RenameSkole, {"dato", "maned", "manedsnavn", "Tertial", "Status", "ansvar_kode", "ansvar_navn", "kommunalsjefomrade", "funksjon_kode", "art_key", "Hovedgruppe", "Undergruppe", "KOSTRA_Art", "Kontokode", "Kontonavn", "Budsjett", "Regnskap", "Avvik", "Merforbruk", "Aarsbudsjett"}),
				
				    // BoMiljø data
				    SourceBo = Csv.Document(File.Contents(DataRoot & "Visma_ERP_BoMiljo_Transactions_2026.csv"), [Delimiter=",", Columns=15, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    HeadersBo = Table.PromoteHeaders(SourceBo, [PromoteAllScalars=true]),
				    TypeBo = Table.TransformColumnTypes(HeadersBo, {
				        {"dato", type date}, {"Måned_Nr", Int64.Type}, {"Måned", type text}, {"Tertial", type text},
				        {"Status", type text}, {"Avdeling", type text}, {"Tjenesteområde", type text},
				        {"KOSTRA_Funksjon", type text}, {"KOSTRA_Art", type text}, {"Kontokode", type text},
				        {"Kontonavn", type text}, {"Hovedgruppe", type text}, {"Undergruppe", type text},
				        {"Budsjett", type number}, {"Regnskap", type number}
				    }, "en-US"),
				    AddAvvikBo = Table.AddColumn(TypeBo, "Avvik", each [Budsjett] - [Regnskap], type number),
				    AddMerforbrukBo = Table.AddColumn(AddAvvikBo, "Merforbruk", each if [Avvik] < 0 then -[Avvik] else 0, type number),
				    AddRespCodeBo = Table.AddColumn(AddMerforbrukBo, "ansvar_kode", each "2540", type text),
				    AddRespNameBo = Table.AddColumn(AddRespCodeBo, "ansvar_navn", each "Kommunal Boenhet 2540", type text),
				    AddFunkBo = Table.AddColumn(AddRespNameBo, "funksjon_kode", each Text.From([KOSTRA_Funksjon]), type text),
				    AddSektorBo = Table.AddColumn(AddFunkBo, "kommunalsjefomrade", each [Tjenesteområde], type text),
				    AddArtKeyBo = Table.AddColumn(AddSektorBo, "art_key", each Text.From([KOSTRA_Art]) & "|" & Text.From([Kontokode]) & "|" & Text.From([Kontonavn]), type text),
				    AddAnnualBudgetBo = Table.AddColumn(AddArtKeyBo, "Aarsbudsjett", each [Budsjett] * 1.5, type number),
				    RenameBo = Table.RenameColumns(AddAnnualBudgetBo, {{"Måned_Nr", "maned"}, {"Måned", "manedsnavn"}}),
				    ColsBo = Table.SelectColumns(RenameBo, {"dato", "maned", "manedsnavn", "Tertial", "Status", "ansvar_kode", "ansvar_navn", "kommunalsjefomrade", "funksjon_kode", "art_key", "Hovedgruppe", "Undergruppe", "KOSTRA_Art", "Kontokode", "Kontonavn", "Budsjett", "Regnskap", "Avvik", "Merforbruk", "Aarsbudsjett"}),
				
				    Combined = Table.Combine({ColsSkole, ColsBo})
				in
				    Combined

	annotation PBI_ResultType = Table

