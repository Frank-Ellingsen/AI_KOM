		summarizeBy: none
		sourceColumn: navn

	column tittel
		dataType: string
		summarizeBy: none
		sourceColumn: tittel

	column niva
		dataType: string
		summarizeBy: none
		sourceColumn: niva

	column niva_tekst
		dataType: string
		summarizeBy: none
		sourceColumn: niva_tekst

	column sektor_kode
		dataType: string
		summarizeBy: none
		sourceColumn: sektor_kode

	column kommunalsjefomrade
		dataType: string
		summarizeBy: none
		sourceColumn: kommunalsjefomrade

	column ansvar_kode
		dataType: string
		summarizeBy: none
		sourceColumn: ansvar_kode

	column enhet_navn
		dataType: string
		summarizeBy: none
