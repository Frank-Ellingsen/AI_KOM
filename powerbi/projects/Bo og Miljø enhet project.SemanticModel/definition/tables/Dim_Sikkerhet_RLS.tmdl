	partition Dim_Sikkerhet_RLS = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "Dim_Sikkerhet_RLS.csv"), [Delimiter=";", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Headers, {
				        {"bruker_upn", type text}, {"navn", type text}, {"tittel", type text},
				        {"niva", type text}, {"niva_tekst", type text}, {"sektor_kode", type text},
				        {"kommunalsjefomrade", type text}, {"ansvar_kode", type text}, {"enhet_navn", type text},
				        {"har_full_tilgang", Int64.Type}, {"rls_rolle", type text}, {"teams_team_navn", type text},
				        {"teams_kanal", type text}, {"teams_rapport_fane", type text},
				        {"powerbi_teams_app_url", type text}, {"delegeringsfullmakt_nok", type number},
				        {"controller_navn", type text}, {"controller_epost", type text}
				    }, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
