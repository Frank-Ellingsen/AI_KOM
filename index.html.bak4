                                Premieavvik på 36 MNOK amortiseres over 7 år lineært jf. regnskapsforskriften § 5-4.<br>
                                <span style="font-size:10.5px; color:var(--text-muted);">KLP & SPK: Årlig aktuarmessig avstemming utført.</span>
                            </div>
                        </div>
                        <div style="background:#ffffff; border:1px solid var(--border-light); border-left:3px solid var(--success-green); padding:10px 14px; border-radius:3px;">
                            <div style="font-size:11px; font-weight:700; color:var(--navy-dark); display:flex; justify-content:space-between; align-items:center;">
                                <span>🏦 Disposisjonsfond mot Handlingsregelen</span>
                                <span class="status-badge" style="background:#dcfce7; color:#15803d; font-size:10px;">6.7 % saldo</span>
                            </div>
                            <div style="margin-top:6px; font-size:11.5px; color:var(--text-secondary); line-height:1.5;">
                                Saldo disposisjonsfond: <strong>485 000 000 NOK</strong> (Krav: min. 6.0 % av driftsinntekter).<br>
                                Handlingsrom / buffer over kravet: <strong>+50 800 000 NOK (🟢 Trygg buffer)</strong>.<br>
                                <span style="font-size:10.5px; color:var(--text-muted);">Kommuneloven § 14-5: Sikrer mot uforutsette inntektssvingninger.</span>
                            </div>
                        </div>
                    </div>` : ''}
                `;
            }

            // 4. Knytt til triage & simulator hvis aktuelt
            if (sectorKey === 'OPPVEKST') {
                loadTriageUnit('ENHET_202');
                switchSimulatorUnit('SKOLE');
            } else if (sectorKey === 'HELSE') {
                loadTriageUnit('ENHET_401');
                switchSimulatorUnit('HELSE');
            } else if (sectorKey === 'BYUTVIKLING') {
                loadTriageUnit('ENHET_301');
                switchSimulatorUnit('VAR');
            } else if (sectorKey === 'ORG_TEK') {
                loadTriageUnit('ENHET_501');
                switchSimulatorUnit('FINOPS');
            } else if (sectorKey === 'OKONOMI' || sectorKey === 'ALL') {
                loadTriageUnit('KONSERN');
                switchSimulatorUnit('FINANS');
            }

            // 5. Oppdater EVM nøkkeltall for valgt virksomhetsområde
            updateKpiRow(sectorKey);

            showToast(`🏢 Valgt ansvarsområde: ${data.title}`);
        }

        function updateKpiRow(sectorKey) {
            const data = SEKTOR_DATA[sectorKey] || SEKTOR_DATA["ALL"];
            if (!data || !data.evm) return;

            // 1. Tittel og Badge over nøkkeltallene
            const titleEl = document.getElementById("kpi-active-sector-title");
            if (titleEl) titleEl.textContent = `${data.icon} ${data.title}`;
            const badgeEl = document.getElementById("kpi-active-sector-badge");
            if (badgeEl) badgeEl.textContent = data.evm.badge;

            // 2. Synkroniser dropdown
            const selectEl = document.getElementById("kpi-sector-select");
            if (selectEl && selectEl.value !== sectorKey) {
                selectEl.value = sectorKey;
            }

            // 3. Planlagt Verdi (PV YTD)
            const pvVal = document.getElementById("kpi-val-pv");
            if (pvVal) pvVal.textContent = data.evm.pv;
            const pvSub = document.getElementById("kpi-sub-pv");
            if (pvSub) pvSub.textContent = data.evm.pv_sub;

            // 4. Påløpt Kostnad (AC YTD)
            const acVal = document.getElementById("kpi-val-ac");
            if (acVal) acVal.textContent = data.evm.ac;
            const acSub = document.getElementById("kpi-sub-ac");
            if (acSub) acSub.textContent = data.evm.ac_sub;

            // 5. Kostnadsavvik (CV)
            const cvVal = document.getElementById("kpi-val-cv");
            if (cvVal) {
                cvVal.textContent = data.evm.cv;
                if (data.evm.cv_alert) {
                    cvVal.classList.add("kpi-alert");
                } else {
                    cvVal.classList.remove("kpi-alert");
                }
            }
            const cvSub = document.getElementById("kpi-sub-cv");
            if (cvSub) {
                cvSub.textContent = data.evm.cv_sub;
                if (data.evm.cv_alert) {
                    cvSub.classList.add("kpi-alert");
                } else {
                    cvSub.classList.remove("kpi-alert");
                }
            }

            // 6. Kostnadsindeks (CPI)
            const cpiVal = document.getElementById("kpi-val-cpi");
            if (cpiVal) {
                cpiVal.textContent = data.evm.cpi;
                if (data.evm.cpi_alert) {
                    cpiVal.classList.add("kpi-alert");
                } else {
                    cpiVal.classList.remove("kpi-alert");
                }
            }
            const cpiSub = document.getElementById("kpi-sub-cpi");
            if (cpiSub) cpiSub.textContent = data.evm.cpi_sub;

            // 7. Sluttprognose (EAC)
            const eacVal = document.getElementById("kpi-val-eac");
            if (eacVal) eacVal.textContent = data.evm.eac;
            const eacSub = document.getElementById("kpi-sub-eac");
            if (eacSub) {
                eacSub.textContent = data.evm.eac_sub;
                if (data.evm.eac_alert) {
                    eacSub.classList.add("kpi-alert");
                } else {
                    eacSub.classList.remove("kpi-alert");
                }
            }

            // 8. Uthev aktiv rad i sammenstillingstabell
            const rows = document.querySelectorAll("#sector-comparison-tbody tr");
            rows.forEach(r => {
                if (r.id === "row-sec-all") {
                    r.style.background = "#f8fafc";
                } else {
                    r.style.background = "";
                }
            });
            const activeRow = document.getElementById(`row-sec-${sectorKey.toLowerCase()}`);
            if (activeRow) {
                activeRow.style.background = "#e0f2fe";
            }

            // Synkroniser månedsmøte-rapporteringen til valgt virksomhetsområde
            currentMeetingSector = sectorKey;
            if (typeof renderMeetingPack === 'function') {
                renderMeetingPack(sectorKey, currentMeetingLevel);
            }
        }

        function toggleSectorComparisonTable() {
            const container = document.getElementById("sector-comparison-container");
            const btn = document.getElementById("btn-toggle-sector-comp");
            if (!container) return;
            if (container.style.display === "none" || container.style.display === "") {
                container.style.display = "block";
                if (btn) btn.innerHTML = "▲ Skjul sammenstilling";
            } else {
                container.style.display = "none";
                if (btn) btn.innerHTML = "📋 Vis alle 6 områder tabell";
            }
        }

        // ==========================================================================
        // 2B. MÅNEDLIG MØTERAPPORTERING & NIVÅSTYRING (NIVÅ 1, NIVÅ 2, NIVÅ 3)
        // ==========================================================================
        let currentMeetingLevel = 'NIVA1';
        let currentMeetingSector = 'ALL';

