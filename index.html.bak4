            "RAPPORT_MONSTER": {
                title: "Standardisert Rapporteringsmønster: 4-Punkts Avvik og Effektprognose",
                file: "templates/RAPPORTMONSTER_AVVIK_OG_EFFEKTPROGNOSE.docx",
                body: `<h3>STANDARDIZERT 4-PUNKTS AVVIK OG EFFEKTPROGNOSE</h3>
<p><strong>Dokument-ID:</strong> MAL-AVVIK-EFFEKT-001 | <strong>Gjelder:</strong> Alle ledelsesnivåer 1–5</p>
<hr>
<h4>DE 4 OBLIGATORISKE PUNKTER:</h4>
<ol>
    <li><strong>1. Avvik hittil i år (YTD Variance):</strong> Presist avvik i kroner og prosent mot periodisert budsjett i Visma ERP.</li>
    <li><strong>2. Årsak til avvik (Root Cause Analysis):</strong> Dypdykk i underliggende drivere (sykefravær, NAV-etterslep, prisstigning) via Glass-Box RAG.</li>
    <li><strong>3. Forslag til Action (Corrective Action Plan):</strong> Strakstiltak (0–30 dager), operative tiltak (30–90 dager), politiske tiltak.</li>
    <li><strong>4. Kvantifisert Effekt & EOY Balanse:</strong> Monte Carlo-beregning av helårsavvik før og etter tiltak per 31.12.</li>
</ol>
<h4>KRAV FRA KOMMUNEREVISJONEN (PORT 9):</h4>
<p>Hver genererte rapport forsegles med SHA-256 hash i <code>Audit_AI_Actions</code> slik at Kontrollutvalget kan verifisere at forutsatte tiltak faktisk ble gjennomført.</p>`
            },
            "RAMMEVERK_MANED": {
                title: "Rammeverk for Månedlig Avviks- og Tiltaksrapportering",
                file: "bruker-guides/MANEDLIG_AVVIKSRAPPORT_RAMMEVERK.md",
                body: `<h3>RAMMEVERK FOR MÅNEDLIG AVVIKS- OG TILTAKSRAPPORT</h3>
<p><strong>Kristiansand Kommune</strong> — Økonomi og Virksomhetsstyring</p>
<hr>
<h4>AVVIKSTERSKLER PER LEDELSESNIVÅ:</h4>
<ul>
    <li><strong>Nivå 1 (Bystyret):</strong> Avvik > 5 000 000 kr (> 3.0 % av sektorramme). Prinsipielle avvik og fondstapping jf. § 14-5.</li>
    <li><strong>Nivå 2 (Kommunedirektør):</strong> Avvik > 2 000 000 kr (> 2.0 % av samlet drift). Tverrsektorielle administrative strakstiltak.</li>
    <li><strong>Nivå 3 (Kommunalsjef):</strong> Avvik > 500 000 kr (> 5.0 % av enhetens ramme). Sektorvise vikar- og overtidstiltak.</li>
    <li><strong>Nivå 4 (Seksjonsleder):</strong> Avvik > 200 000 kr (> 5.0 % av seksjonens ramme). Prosjekt- og konsulentavvik.</li>
    <li><strong>Nivå 5 (Enhetsleder):</strong> Avvik > 50 000 kr (> 5.0 % på enkeltart). Linjeavvik på vikarer og sykefravær.</li>
</ul>
<h4>DEN MÅNEDLIGE RAPPORTERINGSSLØYFEN:</h4>
<p>Dag 1–3: Månedsoppgjør Visma ERP -> Dag 4: PII-vask og ETL til SQLite -> Dag 5: Avviksdeteksjon & AI-tiltak -> Dag 6–7: HITL Controller Sign-off -> Dag 8: Distribusjon til ledere 1–5.</p>`
            },
            "FT_GUIDE": {
                title: "Visuell Datakommunikasjon og Storytelling med Data (Financial Times Guide)",
                file: "docs/VISUAL_STORYTELLING_FT_GUIDE.md",
                body: `<h3>VISUELL DATAKOMMUNIKASJON OG STORYTELLING MED DATA</h3>
<p><strong>Basert på Financial Times Visual Vocabulary</strong> & Cleveland & McGills persepsjonsskala</p>
<hr>
<h4>KOGNITIV NØYAKTIGHETSSKALA (CLEVELAND & McGILL):</h4>
<ol>
    <li><strong>Posisjon langs felles akse:</strong> Høyest nøyaktighet (Stolpediagram, Bullet charts, Linjediagram).</li>
    <li><strong>Posisjon langs usentrerte akser:</strong> Sparklines i tabeller.</li>
    <li><strong>Lengde og vinkel:</strong> Trappediagram, Waterfall / Budsjettbro.</li>
    <li><strong>Areal og fargemetning:</strong> Treemaps, Heatmaps.</li>
    <li><strong>Forbudt i økonomirapportering:</strong> Kakediagrammer / 3D-diagrammer (villedende grafisk persepsjon).</li>
</ol>
<h4>DIAGRAMTYPER TILPASSES 4-PUNKTS RAPPORTEN:</h4>
<ul>
    <li><strong>1. Avvik YTD:</strong> Bullet Chart & Diverging Bar (Mål- og avviksstolpe).</li>
    <li><strong>2. Årsak til avvik:</strong> Waterfall Chart (Budsjettbro: Opprinnelig -> Vikarer -> Overtid -> Tiltak).</li>
    <li><strong>3. Action & EOY Balanse:</strong> Fan Chart (Viftediagram for P10 / P50 / P90 konfidensbaner).</li>
    <li><strong>4. Hurtigovervåking:</strong> Sparklines integrert direkte i tabellceller.</li>
</ul>`
            }
        };

        function previewDocument(docKey) {
            const data = DOC_CONTENT[docKey] || DOC_CONTENT["SAKSFREMLEGG"];
            document.getElementById("modal-doc-title").innerText = data.title;
            document.getElementById("modal-doc-body").innerHTML = data.body;
            document.getElementById("modal-download-link").setAttribute("href", data.file);
            document.getElementById("doc-modal").style.display = "flex";
        }

        function closeModal() {
            document.getElementById("doc-modal").style.display = "none";
        }

        function closeModalOnBackdrop(e) {
            if (e.target.id === "doc-modal") {
                closeModal();
            }
        }

        function copyModalContent() {
            const bodyText = document.getElementById("modal-doc-body").innerText;
            navigator.clipboard.writeText(bodyText).then(() => {
                alert("✓ Dokumenttekst kopiert til utklippstavlen!");
            });
        }

        /* ==========================================================================
           OFFICE HUB V2: INTERAKTIVE FUNKSJONER (TIDSLINJE, TRIAGE & CHAT)
           ========================================================================== */
        
        // 1. Års- og månedsløyfe
        const MONTH_DATA = {
            1: { mode: "MÅNEDSRAPPORTERING M1 (Januar)", deadline: "Frist KOSTRA: 15. januar (Fullført)", highlight: false },
            2: { mode: "MÅNEDSRAPPORTERING M2 (Februar)", deadline: "Frist KOSTRA 2. runde: 23. februar (Fullført)", highlight: false },
            3: { mode: "1. TERTIAL / ÅRSREGNSKAP (Mars)", deadline: "Frist Årsregnskap: 31. mars (Fullført)", highlight: true },
            4: { mode: "MÅNEDSRAPPORTERING M4 (April)", deadline: "Revisjonsberetning: 15. april (Fullført)", highlight: false },
            5: { mode: "1. TERTIALRAPPORTERING (Mai)", deadline: "Bystyrebehandling T1: 25. mai (Fullført)", highlight: false },
            6: { mode: "MÅNEDSRAPPORTERING M6 (Juni)", deadline: "Revidert nasjonalbudsjett oppdatering: 2. juni", highlight: false },
            7: { mode: "MÅNEDSRAPPORTERING M7 (Juli)", deadline: "Sommerlukking og ferieavstemming", highlight: false },
            8: { mode: "MÅNEDSRAPPORTERING M8 (August)", deadline: "Innspill til ny HØP 2027–2030: 15. august", highlight: false },
            9: { mode: "🔴 MÅNEDSRAPPORTERING M9 (September)", deadline: "Frist Formannskapet: 28. september (4 dager igjen)", highlight: true },
            10: { mode: "MÅNEDSRAPPORTERING M10 (Oktober)", deadline: "Statsbudsjettet og rammejustering: 7. oktober", highlight: false },
            11: { mode: "HØP & BUDSJETTINNSPILL (November)", deadline: "Formannskapets innstilling: 25. november", highlight: false },
            12: { mode: "BUDSJETTVEDTAK M12 (Desember)", deadline: "Bystyrets endelige HØP-vedtak: 18. desember", highlight: true }
        };

        function selectMonth(m) {
            document.querySelectorAll(".month-pill").forEach((btn, idx) => {
                if (idx + 1 === m) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            });
            const d = MONTH_DATA[m];
            if (d) {
                document.getElementById("timeline-active-mode").innerText = d.mode;
                document.getElementById("timeline-deadline").innerText = d.deadline;
            }
        }

        // 2. Smart Arbeidskø & Zero-Click Triage
