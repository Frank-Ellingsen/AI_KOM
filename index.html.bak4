    <footer class="hub-footer">
        <div>Kristiansand Kommune — Økonomi og Virksomhetsstyring | Utviklet av Frank Ellingsen</div>
        <div>Standarder: ISO 21508 EVM | Edward Tufte Data-Ink | Eurocities Algorithmic Transparency</div>
        <div>Lokal SQLite DB: <code>kommune_golden_record.db</code></div>
    </footer>

    <!-- INTERAKTIVITET OG SHA-256 HASHING -->
    <script>
        let currentEngine = "Gemini 3.8 Flash (0 % CPU)";
        let auditLogEntries = [
            {
                timestamp: new Date().toISOString(),
                query: "Hvilke regler gjelder for budsjettendring jf. Kommuneloven § 14-5?",
                action: "APPROVED",
                user: "Frank Ellingsen",
                hash: "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
            }
        ];

        function setQuery(text) {
            document.getElementById("rag-input").value = text;
            executeMockRAG();
        }

        async function computeSHA256(message) {
            const msgBuffer = new TextEncoder().encode(message);
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        }

        async function executeMockRAG() {
            const query = (document.getElementById("rag-input").value || "").trim();
            const outputCard = document.getElementById("rag-output");

            outputCard.style.opacity = "0.5";

            // 1. Forsøk live RAG-oppslag mot lokal Hub API tjener hvis tilkoblet
            try {
                const res = await fetch(`${API_BASE}/api/rag-query`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ query: query, top_k: 2 })
                });
                if (res.ok) {
                    const data = await res.json();
                    if (data.ok && data.results && data.results.length > 0) {
                        outputCard.style.opacity = "1";
                        const first = data.results[0];
                        outputCard.innerHTML = `
                            <strong>Vurdering jf. ${first.paragraf || 'Kommuneloven'}:</strong><br/>
                            ${first.tekst || first.tittel}<br/><br/>
                            <strong>Kilde- og regelverksforankring:</strong><br/>
                            Kilde: <em>${first.kilde || 'Kommuneloven'}</em>. Relevans: ${Math.round((first.relevans_score || 0.9)*100)} %.
                            <div class="audit-meta-row" style="margin-top:8px;">
                                <span>Kilde: ${first.paragraf || 'Kommuneloven'}, Økonomireglementet</span>
                                <span id="audit-hash-display">SHA-256: ${(data.sha256 || '').substring(0, 16)}...</span>
                            </div>
                        `;
                        return;
                    }
                }
            } catch (err) {
                // Hub API ikke tilgjengelig - benytter lokal heuristikk under
            }

            // 2. Intelligent klientside fallback
            await renderClientRAGResponse(query, outputCard);
        }

        async function renderClientRAGResponse(query, outputCard) {
            outputCard.style.opacity = "1";
            const q = (query || "").toLowerCase();
            let title = "Vurdering jf. Kommuneloven § 14-5 (Budsjettbalanse & Handleplikt):";
            let body = "Dersom det i løpet av budsjettåret oppstår vesentlige avvik som truer budsjettmessig balanse eller realismekravet, plikter kommunedirektøren uten ugrunnet opphold å fremme sak om endring av årsbudsjettet for Bystyret.<br/><br/>For Oppvekst og utdanning må det avklares om merforbruket på vikarer (-645 000 kr) og overtid (-379 000 kr) kan dekkes ved omdisponering innenfor rammen, eller om det kreves inndekning via kommunens disposisjonsfond.";
            let source = "Kommuneloven § 14-5, Økonomireglementet § 3-1";

            if (q.includes("vikar") || q.includes("kostra") || q.includes("1020") || q.includes("refusjon") || q.includes("sykepeng") || q.includes("1600")) {
                title = "Vurdering jf. KOSTRA Kontoplan & Kommuneloven § 14-6 fjerde ledd (Bruttoprinsippet):";
                body = "Lønnsutgifter til sykevikarer (KOSTRA art 1020) og refusjoner for sykepenger fra NAV (KOSTRA art 1600/1690) skal føres <strong>brutto</strong> jf. Kommuneloven § 14-6 fjerde ledd. Det er ikke tillatt å motregne utgifter mot forventede refusjoner på samme konto.<br/><br/>Utestående refusjonskrav fra NAV må tapsavstemmes og periodiseres i månedsoppgjøret. Avviket på Enhet 202 (+645 000 kr) skyldes primært 48 dagers saksbehandlingstid hos NAV.";
                source = "KOSTRA Veileder 2026, Kommuneloven § 14-6, GKRS kap. 4";
            } else if (q.includes("delegasjon") || q.includes("fullmakt") || q.includes("omdisponer")) {
                title = "Vurdering jf. Kristiansand kommunes Delegeringsreglement § 3:";
                body = "Kommunedirektøren og kommunalsjef har delegert administrativ fullmakt til å omdisponere budsjettposter innenfor tildelt sektorramme, forutsatt at bevilgningens formål ikke endres. Endringer som binder kommunen for fremtidige budsjettår, eller omdisponeringer over 5 000 000 kr, krever formelt vedtak i Bystyret jf. Kommuneloven § 14-5.";
                source = "Delegeringsreglement for Kristiansand kommune § 3, Kommuneloven § 13-1";
            } else if (q.includes("hta") || q.includes("tillitsvalgt") || q.includes("drøfting") || q.includes("partssamarbeid") || q.includes("turnus")) {
                title = "Vurdering jf. Hovedtariffavtalen (HTA) § 4 & Arbeidsmiljøloven:";
                body = "Arbeidsgiver plikter å gjennomføre drøftingsmøter med tillitsvalgte (Fagforbundet, Delta, NSF, Utdanningsforbundet) <em>før</em> iverksettelse av vikarstopp, endring i turnusordninger eller innføring av langvakter.<br/><br/>Tiltak T2 og T3 krever signert protokoll for å overholde Stage-Gate Port 9.";
                source = "HTA § 4, Hovedavtalen del B § 3, Arbeidsmiljøloven kap. 10";
            }

            const hash = await computeSHA256(query + "|" + new Date().toISOString());
            outputCard.innerHTML = `
                <strong>${title}</strong><br/>
                ${body}
                <div class="audit-meta-row" style="margin-top:8px;">
                    <span>Kilde: ${source}</span>
                    <span id="audit-hash-display">SHA-256: ${hash.substring(0, 16)}...</span>
                </div>
            `;
        }

        async function signAndSaveAudit() {
            const query = document.getElementById("rag-input").value;
            const notes = document.getElementById("hitl-notes").value;
            const status = document.querySelector('input[name="hitl_status"]:checked').value;
            const now = new Date().toISOString();
            
            const payload = `Frank Ellingsen|${query}|${status}|${notes}|${now}`;
            const hash = await computeSHA256(payload);

            auditLogEntries.push({
                timestamp: now,
                query: query,
                action: status,
                user: "Frank Ellingsen",
                notes: notes,
                hash: hash
            });

            const confirmBox = document.getElementById("sign-confirmation");
            confirmBox.innerText = `✓ Signert og arkivert! SHA-256: ${hash.substring(0, 24)}...`;
            confirmBox.style.display = "block";

            setTimeout(() => {
                confirmBox.style.display = "none";
            }, 5000);
        }

        function exportAuditTrail() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(auditLogEntries, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", "audit_log_kristiansand_office_hub.json");
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function toggleEngine() {
            if (currentEngine.includes("Gemini")) {
                currentEngine = "Lokal Ollama (Høy CPU-last)";
            } else {
                currentEngine = "Gemini 3.8 Flash (0 % CPU)";
            }
            document.getElementById("active-engine-label").innerText = currentEngine;
            document.getElementById("engine-btn").innerText = `🔄 Bytt Motor (Aktiv: ${currentEngine.split(' ')[0]})`;
        }

        function filterEntity(entity) {
            if (entity === 'SKOLE') {
                selectSector('OPPVEKST');
            } else if (entity === 'BO') {
                selectSector('HELSE');
            } else {
                selectSector('ALL');
            }
        }

        /* ==========================================================================
           VEKTORDATABASE OPPDATERING & PROGRESS API
           Kobler opp mot lokal http://127.0.0.1:8766/api/status og /update-vectordb
           ========================================================================== */
        const API_BASE = "http://127.0.0.1:8766";
        let pollInterval = null;

        async function fetchVectorDbStatus() {
            try {
                const res = await fetch(`${API_BASE}/api/status`);
                if (!res.ok) return;
                const data = await res.json();
                if (data.ok && data.db_stats) {
                    const stats = data.db_stats;
                    const badge = document.getElementById("vdb-badge-header");
                    if (badge && stats.chunks_count) {
                        badge.innerText = `Vektor-DB: ${stats.chunks_count.toLocaleString("no-NO")} biter (${stats.source_files_count} dok)`;
                    }
                    const meta = document.getElementById("vdb-stats-meta");
                    if (meta) {
                        meta.innerText = `data/raw: ${stats.raw_files_count} filer | DB: ${stats.chunks_count.toLocaleString("no-NO")} biter (${stats.source_files_count} indeksert)`;
                    }

                    // Dersom indeksering allerede pågår i bakgrunnen
                    if (data.update_state && data.update_state.is_updating) {
                        const panel = document.getElementById("vectordb-panel");
                        if (panel) panel.style.display = "block";
                        startPollingProgress();
                    }
                }
            } catch (err) {
                // Hub API ikke tilkoblet ennå
                console.log("Hub API venter:", err.message);
            }
        }

        async function triggerVectorDbUpdate() {
            const btn = document.getElementById("btn-update-vectordb");
            const panel = document.getElementById("vectordb-panel");
            const badge = document.getElementById("vdb-status-badge");
            const msg = document.getElementById("vdb-status-msg");
            const pbar = document.getElementById("vdb-progress-bar");
            const timeLabel = document.getElementById("vdb-time-label");

            panel.className = "vectordb-panel running";
            panel.style.display = "block";
            btn.disabled = true;
            btn.innerHTML = "⏳ Starter...";
            badge.className = "status-badge";
            badge.innerText = "Pågår";
            badge.style.color = "var(--accent-blue)";
            badge.style.borderColor = "var(--accent-blue)";
            msg.innerText = "Kobler til lokal oppdateringstjeneste (port 8766)...";
            pbar.style.width = "5%";
            timeLabel.innerText = "Tid: 0.0s";

            try {
                const res = await fetch(`${API_BASE}/api/update-vectordb`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                const data = await res.json();
                if (!res.ok && res.status !== 409) {
                    throw new Error(data.error || "Kunne ikke starte indeksering.");
                }

                btn.innerHTML = "⚡ Indekserer...";
                startPollingProgress();

            } catch (err) {
                console.error("Oppdateringsfeil:", err);
                panel.className = "vectordb-panel error";
                badge.innerText = "Tilkoblingsfeil";
                badge.style.color = "var(--alert-red)";
                badge.style.borderColor = "var(--alert-red)";
                msg.innerHTML = `⚠️ Lokal bakgrunnstjeneste svarer ikke på port 8766.<br>
                <strong>Løsning:</strong> Dobbelklikk på <code>oppdater_vektor_db.bat</code> i prosjektmappen, eller start <code>start_kommune_ai.bat</code>.<br>
                <div style="margin-top: 8px;">
                    <button class="btn" onclick="triggerVectorDbUpdate()">🔄 Prøv på nytt</button>
                </div>`;
                btn.disabled = false;
                btn.innerHTML = "⚡ Oppdater Vektor-DB";
            }
        }

        function startPollingProgress() {
            if (pollInterval) clearInterval(pollInterval);
            const btn = document.getElementById("btn-update-vectordb");
            const panel = document.getElementById("vectordb-panel");
            const badge = document.getElementById("vdb-status-badge");
            const msg = document.getElementById("vdb-status-msg");
            const pbar = document.getElementById("vdb-progress-bar");
            const timeLabel = document.getElementById("vdb-time-label");
            const meta = document.getElementById("vdb-stats-meta");

            pollInterval = setInterval(async () => {
                try {
                    const res = await fetch(`${API_BASE}/api/progress`);
                    if (!res.ok) return;
                    const json = await res.json();
                    const p = json.progress;

                    if (!p) return;

                    pbar.style.width = Math.max(5, p.percent) + "%";
                    timeLabel.innerText = `Tid: ${p.elapsed_seconds || 0}s`;
                    msg.innerText = p.message || "Arbeider med indeksering...";

                    if (p.current_file) {
                        meta.innerText = `Behandler: ${p.current_file} (${p.files_done || 0}/${p.total_files || 0} filer)`;
                    }

                    if (!p.is_updating && p.state === "done") {
                        clearInterval(pollInterval);
                        pollInterval = null;
                        pbar.style.width = "100%";
                        panel.className = "vectordb-panel success";
                        badge.innerText = "Fullført";
                        badge.style.color = "var(--success-green)";
                        badge.style.borderColor = "var(--success-green)";
                        msg.innerHTML = `✅ <strong>Indeksering fullført!</strong> Vektordatabasen er oppdatert med nye dokumenter fra <code>data/raw</code>.`;
                        
                        btn.disabled = false;
                        btn.innerHTML = "⚡ Oppdater Vektor-DB (Fullført)";
                        fetchVectorDbStatus();

                        setTimeout(() => {
                            btn.innerHTML = "⚡ Oppdater Vektor-DB";
                        }, 6000);
                    } else if (!p.is_updating && p.state === "error") {
                        clearInterval(pollInterval);
                        pollInterval = null;
                        panel.className = "vectordb-panel error";
                        badge.innerText = "Feil";
                        badge.style.color = "var(--alert-red)";
                        badge.style.borderColor = "var(--alert-red)";
                        msg.innerText = `❌ Feil under indeksering: ${p.error}`;
                        btn.disabled = false;
                        btn.innerHTML = "⚡ Oppdater Vektor-DB";
                    }
                } catch (e) {
                    console.warn("Fremdriftspolling feilet:", e);
                }
            }, 800);
        }

        // Hent status ved oppstart
        document.addEventListener("DOMContentLoaded", () => {
            fetchVectorDbStatus();
        });
        setTimeout(fetchVectorDbStatus, 500);

        /* ==========================================================================
           INTERAKTIV SAKSGENERATOR, DOKUMENTBANK & POWER BI VISER
           ========================================================================== */

        const SAKS_TEKSTER = {
            "SKOLE_NIVA3": `SAKSFREMLEGG: BUDSJETTREGULERING 2. TERTIAL 2026 — KOMMUNAL SKOLE (KOSTRA 202)
