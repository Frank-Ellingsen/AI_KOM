                renterisiko: { gjeld: "7 250 000 000 NOK", snittrente: "4.12 %", fast: "58 %", flytende: "42 %", folsomhet: "-7.2 MNOK per +0.50 % NIBOR" },
                pensjon_premieavvik: { innbetalt: "348 MNOK", kostnad: "312 MNOK", premieavvik: "+36 MNOK", amortisering: "7 år lineært" },
                disposisjonsfond: { saldo: "485 000 000 NOK", andel: "6.7 %", krav: "6.0 %", buffer: "+50.8 MNOK over krav" }
            }
        };

        
        // ==========================================================================
        // DYNAMISK SIDEBAR: TOTALER, MOM KONTEKST & LINJEDIAGRAM (INGEN HARDKODING)
        // ==========================================================================
        let currentSidebarChartMode = 'CUM'; // 'CUM' (Akkumulert YTD) eller 'MONTH' (Pr måned)
        let activeSidebarSector = 'ALL';

        function formatNOK(num, decimals = 1) {
            if (num === undefined || num === null || isNaN(num)) return "0 kr";
            const abs = Math.abs(num);
            const sign = num < 0 ? "-" : (num > 0 ? "+" : "");
            if (abs >= 1000000000) {
                return sign + (abs / 1000000000).toLocaleString('no-NO', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + " Mrd";
            } else if (abs >= 1000000) {
                return sign + (abs / 1000000).toLocaleString('no-NO', { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + "M";
            } else if (abs >= 1000) {
                return sign + (abs / 1000).toLocaleString('no-NO', { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + "k";
            } else {
                return num.toLocaleString('no-NO') + " kr";
            }
        }

        function formatNOKFull(num) {
            if (num === undefined || num === null || isNaN(num)) return "0 kr";
            return num.toLocaleString('no-NO') + " kr";
        }

        function getSectorMonthlyData(sectorKey) {
            const months = 9; // M1 (Jan) til M9 (Sep)
            const subSectors = ['HELSE', 'OPPVEKST', 'BYUTVIKLING', 'KULTUR', 'ORG_TEK', 'OKONOMI'];
            
            if (sectorKey === 'ALL') {
                const res = {
                    monthly_pv: new Array(months).fill(0),
                    monthly_ac: new Array(months).fill(0),
                    monthly_cv: new Array(months).fill(0),
                    cum_cv: new Array(months).fill(0),
                    cum_pv: new Array(months).fill(0),
                    cum_ac: new Array(months).fill(0)
                };
                for (let m = 0; m < months; m++) {
                    for (const s of subSectors) {
                        const sData = SEKTOR_DATA[s];
                        if (sData && sData.monthly) {
                            res.monthly_pv[m] += sData.monthly.pv[m];
                            res.monthly_ac[m] += sData.monthly.ac[m];
                            res.monthly_cv[m] += sData.monthly.cv[m];
                        }
                    }
                }
                let run_cv = 0, run_pv = 0, run_ac = 0;
                for (let m = 0; m < months; m++) {
                    run_cv += res.monthly_cv[m];
                    run_pv += res.monthly_pv[m];
                    run_ac += res.monthly_ac[m];
                    res.cum_cv[m] = run_cv;
                    res.cum_pv[m] = run_pv;
                    res.cum_ac[m] = run_ac;
                }
                return res;
            } else {
                const sData = SEKTOR_DATA[sectorKey];
                if (!sData || !sData.monthly) return null;
                const res = {
                    monthly_pv: [...sData.monthly.pv],
                    monthly_ac: [...sData.monthly.ac],
                    monthly_cv: [...sData.monthly.cv],
                    cum_cv: [],
                    cum_pv: [],
                    cum_ac: []
                };
                let run_cv = 0, run_pv = 0, run_ac = 0;
                for (let m = 0; m < sData.monthly.cv.length; m++) {
                    run_cv += sData.monthly.cv[m];
                    run_pv += sData.monthly.pv[m];
                    run_ac += sData.monthly.ac[m];
                    res.cum_cv.push(run_cv);
                    res.cum_pv.push(run_pv);
                    res.cum_ac.push(run_ac);
                }
                return res;
            }
        }

        function setSidebarChartMode(mode) {
            currentSidebarChartMode = mode;
            const tabCum = document.getElementById("sb-tab-cum");
            const tabMonth = document.getElementById("sb-tab-month");
            if (tabCum) tabCum.classList.toggle("active", mode === 'CUM');
            if (tabMonth) tabMonth.classList.toggle("active", mode === 'MONTH');
            const titleEl = document.getElementById("sb-chart-title");
            if (titleEl) {
                titleEl.textContent = mode === 'CUM' ? "Akk. merforbruk YTD" : "Månedlig merforbruk";
            }
            renderSidebarLineChart(activeSidebarSector);
        }

        function updateSidebarOverview(sectorKey) {
            activeSidebarSector = sectorKey;
            const data = SEKTOR_DATA[sectorKey] || SEKTOR_DATA["ALL"];
            if (!data) return;

            // Oppdater tittel på linjediagram
            const chartTitleEl = document.getElementById("sb-chart-title");
            if (chartTitleEl) {
                chartTitleEl.textContent = currentSidebarChartMode === 'CUM' ? "Akk. merforbruk YTD" : "Månedlig merforbruk";
            }

            // 1. Tittel, Ikon & Status
            const iconEl = document.getElementById("sb-ov-icon");
            if (iconEl) iconEl.textContent = data.icon;
            const titleEl = document.getElementById("sb-ov-title");
            if (titleEl) {
                titleEl.textContent = sectorKey === 'ALL' ? "Konsern (Alle)" : data.title;
                titleEl.title = data.title;
            }
            const statusEl = document.getElementById("sb-ov-status");
            if (statusEl) {
                statusEl.textContent = data.status_badge.replace(/^[^\w\s]+\s*/, '');
                if (data.status_badge.includes("Kritisk") || data.status_badge.includes("Advarsel")) {
                    statusEl.style.background = "var(--alert-red-bg)";
                    statusEl.style.color = "var(--alert-red)";
                    statusEl.style.borderColor = "rgba(192, 57, 43, 0.3)";
                } else {
                    statusEl.style.background = "var(--success-green-bg)";
                    statusEl.style.color = "var(--success-green)";
                    statusEl.style.borderColor = "rgba(39, 174, 96, 0.3)";
                }
            }

            // 2. Kjerne-totaler for valgt område (Dynamisk beregnet/hentet)
            const mData = getSectorMonthlyData(sectorKey);
            const ytd_pv = mData ? mData.cum_pv[8] : (parseInt(data.ramme.replace(/\D/g, '')) * 0.67);
            const ytd_ac = mData ? mData.cum_ac[8] : parseInt(data.forbruk.replace(/\D/g, ''));
            const ytd_cv = mData ? mData.cum_cv[8] : (ytd_pv - ytd_ac);
            const bac_val = parseInt(data.ramme.replace(/\D/g, ''));
            const cpi_val = ytd_ac > 0 ? (ytd_pv / ytd_ac) : 1.0;
            const eac_val = cpi_val > 0 ? Math.round(bac_val / cpi_val) : bac_val;

            const bacEl = document.getElementById("sb-tot-bac");
            if (bacEl) bacEl.textContent = formatNOK(bac_val, 2).replace("+", "");

            const acEl = document.getElementById("sb-tot-ac");
            if (acEl) acEl.textContent = formatNOK(ytd_ac, 1).replace("+", "");

            const cvEl = document.getElementById("sb-tot-cv");
            if (cvEl) {
                cvEl.textContent = formatNOK(ytd_cv, 2);
                if (ytd_cv < 0) {
                    cvEl.className = "sb-tot-val alert";
                } else if (ytd_cv > 0) {
                    cvEl.className = "sb-tot-val positive";
                } else {
                    cvEl.className = "sb-tot-val";
                }
            }

            const cpiEacEl = document.getElementById("sb-tot-cpi-eac");
            if (cpiEacEl) {
                cpiEacEl.textContent = `${cpi_val.toFixed(3)} / ${formatNOK(eac_val, 2).replace("+", "")}`;
                cpiEacEl.style.color = cpi_val < 0.995 ? "var(--alert-red)" : (cpi_val > 1.002 ? "var(--success-green)" : "var(--navy-dark)");
            }

            // 3. MoM Kontekst (Month-over-Month: M9 vs M8)
            const momDetailsEl = document.getElementById("sb-mom-details");
            const momBadgeEl = document.getElementById("sb-mom-badge");
            if (mData) {
                const m9_cv = mData.monthly_cv[8];
                const m8_cv = mData.monthly_cv[7];
                const delta_cv = m9_cv - m8_cv; // M9 vs M8 månedlig avviksendring
                const m9_cum = mData.cum_cv[8];
                const m8_cum = mData.cum_cv[7];
                const cum_delta = m9_cum - m8_cum; // YTD avviksutvidelse i M9
                
                let trendText = "";
                let badgeClass = "sb-mom-badge";
                if (delta_cv < -50000) {
                    trendText = `<span style="color:var(--alert-red); font-weight:600;">▼ Økende månedsavvik</span> (${formatNOK(delta_cv, 0)} mot M8)`;
                    badgeClass = "sb-mom-badge alert";
                } else if (delta_cv > 50000) {
                    trendText = `<span style="color:var(--success-green); font-weight:600;">▲ Avviksdemping</span> (${formatNOK(delta_cv, 0)} bedre enn M8)`;
                    badgeClass = "sb-mom-badge positive";
                } else {
                    trendText = `<span style="color:var(--text-muted); font-weight:600;">▶ Stabil takt</span> (${formatNOK(delta_cv, 0)} mot M8)`;
                }

                if (momBadgeEl) {
                    momBadgeEl.textContent = `Δ ${formatNOK(delta_cv, 0)}`;
                    momBadgeEl.className = badgeClass;
                }

                if (momDetailsEl) {
                    momDetailsEl.innerHTML = `
                        <div style="display:flex; justify-content:space-between; margin-bottom:2px;">
                            <span>Månedsavvik M9:</span>
                            <strong style="font-family:var(--font-mono); color:${m9_cv < 0 ? 'var(--alert-red)' : (m9_cv > 0 ? 'var(--success-green)' : 'inherit')};">${formatNOK(m9_cv, 2)}</strong>
                        </div>
                        <div style="display:flex; justify-content:space-between; margin-bottom:3px;">
                            <span>Månedsavvik M8:</span>
                            <span style="font-family:var(--font-mono);">${formatNOK(m8_cv, 2)}</span>
                        </div>
                        <div style="padding-top:2px; border-top:1px dashed var(--border-subtle); display:flex; justify-content:space-between; align-items:center;">
                            <span>Akk. YTD MoM:</span>
                            <span style="font-family:var(--font-mono); font-weight:700;">${formatNOK(m8_cum, 1)} → ${formatNOK(m9_cum, 1)}</span>
                        </div>
                        <div style="font-size:9.5px; margin-top:3px; color:var(--text-secondary);">
                            Status: ${trendText}
                        </div>
                    `;
                }
            }

            // 4. Tegn SVG Linjediagram
            renderSidebarLineChart(sectorKey);
        }

        function renderSidebarLineChart(sectorKey) {
            const container = document.getElementById("sb-chart-container");
            if (!container) return;

            const mData = getSectorMonthlyData(sectorKey);
            if (!mData) {
                container.innerHTML = '<div style="padding:10px; font-size:10px; color:var(--text-muted);">Ingen månedstall tilgjengelig</div>';
                return;
            }

            const monthNames = ["Jan", "Feb", "Mar", "Apr", "Mai", "Jun", "Jul", "Aug", "Sep"];
            const monthLetters = ["J", "F", "M", "A", "M", "J", "J", "A", "S"];
            
            // Negativt regnskapsavvik (merforbruk) vises som positiv / stigende kurve over null-linjen.
            // Når merforbruket øker stiger kurven; når merforbruket minker/avtar synker kurven nedover mot null.
            const rawSeries = currentSidebarChartMode === 'CUM' ? mData.cum_cv : mData.monthly_cv;
            const dataSeries = rawSeries.map(v => -v);

            const svgWidth = 246;
            const svgHeight = 76;
            const padLeft = 24;
            const padRight = 38;
            const padTop = 10;
            const padBottom = 16;
            const plotW = svgWidth - padLeft - padRight;
            const plotH = svgHeight - padTop - padBottom;

            let minVal = Math.min(...dataSeries, 0);
            let maxVal = Math.max(...dataSeries, 0);
            let span = maxVal - minVal;
            if (span === 0) span = 1;
            const valFloor = minVal - span * 0.08;
            const valCeil = maxVal + span * 0.08;
            const valRange = valCeil - valFloor;

            function getX(i) {
                return padLeft + i * (plotW / (dataSeries.length - 1));
            }

            function getY(val) {
                return (padTop + plotH) - ((val - valFloor) / valRange) * plotH;
            }

            const yZero = getY(0);

            // Bygg linjesti (SVG path)
            const points = dataSeries.map((v, i) => ({
                x: getX(i),
                y: getY(v),
                val: v,
                rawVal: rawSeries[i],
                month: monthNames[i],
                letter: monthLetters[i]
            }));

            let pathD = `M ${points[0].x.toFixed(1)},${points[0].y.toFixed(1)}`;
            for (let i = 1; i < points.length; i++) {
                pathD += ` L ${points[i].x.toFixed(1)},${points[i].y.toFixed(1)}`;
            }

            // Arealfyll (under eller over 0)
            let areaD = `${pathD} L ${points[points.length - 1].x.toFixed(1)},${yZero.toFixed(1)} L ${points[0].x.toFixed(1)},${yZero.toFixed(1)} Z`;

            // Farge: Hvis siste verdi er positiv (merforbruk) -> rød, negativ (mindreforbruk) -> grønn, nøytral -> navy
            const lastVal = dataSeries[dataSeries.length - 1];
            const strokeColor = lastVal > 0 ? "#c0392b" : (lastVal < 0 ? "#27ae60" : "#1b365d");
            const fillColor = lastVal > 0 ? "rgba(192, 57, 43, 0.08)" : (lastVal < 0 ? "rgba(39, 174, 96, 0.08)" : "rgba(27, 54, 93, 0.05)");

            let svgHtml = `
            <svg class="sidebar-chart-svg" viewBox="0 0 ${svgWidth} ${svgHeight}">
                <!-- Null-linje (Budsjettreferanse jf. Tufte) -->
                <line x1="${padLeft - 4}" y1="${yZero.toFixed(1)}" x2="${padLeft + plotW + 2}" y2="${yZero.toFixed(1)}" stroke="#cbd5e1" stroke-dasharray="2,2" stroke-width="1"/>
                <text x="${padLeft - 6}" y="${(yZero + 3).toFixed(1)}" font-size="8" fill="#94a3b8" text-anchor="end" font-family="monospace">0</text>

                <!-- Områdefyll -->
                <path d="${areaD}" fill="${fillColor}" />

                <!-- Hovedkurve -->
                <path d="${pathD}" fill="none" stroke="${strokeColor}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />

                <!-- Månedsbokstaver x-akse -->
                ${points.map(p => `
                    <text x="${p.x.toFixed(1)}" y="${svgHeight - 3}" font-size="8" fill="#94a3b8" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, sans-serif">${p.letter}</text>
                `).join('')}

                <!-- Datapunkter for hver måned med hover-tooltip -->
                ${points.map((p, idx) => {
                    const isLast = idx === points.length - 1;
                    const r = isLast ? 3.5 : 2;
                    const fill = isLast ? strokeColor : "#ffffff";
                    const stroke = strokeColor;
                    const tooltipText = p.val > 0
                        ? `M${idx + 1} (${p.month}): +${formatNOK(p.val, 2).replace('+', '')} merforbruk (Avvik: ${formatNOK(p.rawVal, 2)})`
                        : (p.val < 0 
                            ? `M${idx + 1} (${p.month}): -${formatNOK(Math.abs(p.val), 2).replace('+', '')} mindreforbruk (Avvik: +${formatNOK(Math.abs(p.rawVal), 2)})`
                            : `M${idx + 1} (${p.month}): I balanse (0 kr)`);
                    return `
                        <circle cx="${p.x.toFixed(1)}" cy="${p.y.toFixed(1)}" r="${r}" fill="${fill}" stroke="${stroke}" stroke-width="${isLast ? 1.8 : 1.2}" style="cursor:pointer;" onmouseenter="showSidebarChartTooltip(event, '${tooltipText}')" onmouseleave="hideSidebarChartTooltip()">
                            <title>${tooltipText}</title>
                        </circle>
                    `;
                }).join('')}

                <!-- Direkte merking på siste punkt (M9) jf. Edward Tufte Data-Ink prinsipp -->
                <text x="${(points[points.length - 1].x + 4).toFixed(1)}" y="${(points[points.length - 1].y + 3).toFixed(1)}" font-size="8.5" font-weight="700" fill="${strokeColor}" font-family="monospace">
                    ${lastVal > 0 ? ('+' + formatNOK(lastVal, 1).replace('+', '')) : (lastVal < 0 ? ('-' + formatNOK(Math.abs(lastVal), 1).replace('+', '')) : '0 kr')}
                </text>
            </svg>
            `;

            container.innerHTML = svgHtml;
        }

        function showSidebarChartTooltip(e, text) {
            let tip = document.getElementById("sb-chart-tooltip");
            if (!tip) return;
            tip.textContent = text;
            tip.style.display = "block";
            const rect = e.target.getBoundingClientRect();
            const parentRect = document.getElementById("hub-sidebar").getBoundingClientRect();
            tip.style.left = (rect.left - parentRect.left - 10) + "px";
            tip.style.top = (rect.top - parentRect.top - 24) + "px";
        }

        function hideSidebarChartTooltip() {
            let tip = document.getElementById("sb-chart-tooltip");
            if (tip) tip.style.display = "none";
        }

        function updateSidebarSectorBadges() {
            const map = {
                "ALL": "side-sec-badge-all",
                "HELSE": "side-sec-badge-helse",
                "OPPVEKST": "side-sec-badge-oppvekst",
                "BYUTVIKLING": "side-sec-badge-byutvikling",
                "KULTUR": "side-sec-badge-kultur",
                "ORG_TEK": "side-sec-badge-org_tek",
                "OKONOMI": "side-sec-badge-okonomi"
            };

            for (const [secKey, badgeId] of Object.entries(map)) {
                const badgeEl = document.getElementById(badgeId);
                if (!badgeEl) continue;
                const mData = getSectorMonthlyData(secKey);
                if (!mData) continue;
                const cvYtd = mData.cum_cv[8];
                badgeEl.textContent = formatNOK(cvYtd, 1);
                
                if (cvYtd < -1000000) {
                    badgeEl.style.background = "var(--alert-red)";
                    badgeEl.style.color = "#ffffff";
                } else if (cvYtd < 0) {
                    badgeEl.style.background = "var(--alert-amber)";
                    badgeEl.style.color = "#ffffff";
                } else if (cvYtd > 0) {
                    badgeEl.style.background = "var(--success-green-bg)";
                    badgeEl.style.color = "var(--success-green)";
                    badgeEl.style.border = "1px solid rgba(39, 174, 96, 0.4)";
                } else {
                    badgeEl.style.background = "#e2e8f0";
                    badgeEl.style.color = "var(--navy-dark)";
                }
            }
        }

        
