        function formatNok(val) {
            if (val === 0) return "0";
            const isNeg = val < 0;
            const absStr = Math.abs(val).toLocaleString('nb-NO').replace(/\s/g, ' ');
            return isNeg ? `-${absStr}` : absStr;
        }

        function renderVariancesTable(sectorKey) {
            const data = SECTOR_VARIANCES[sectorKey] || SECTOR_VARIANCES["ALL"];
            const filterLabel = document.getElementById("active-entity-filter");
            if (filterLabel) filterLabel.textContent = data.filterLabel;

            const tbody = document.getElementById("variances-tbody");
            if (!tbody) return;

            let html = "";
            data.rows.forEach(r => {
                const rowClass = r.isAlert ? 'class="alert-row"' : '';
                const avvikColor = r.avvik < 0 ? 'var(--alert-red)' : 'var(--navy-dark)';
                html += `
                    <tr ${rowClass}>
                        <td><span class="tufte-tip" data-tip="${r.tip}">${r.art}</span></td>
                        <td>${r.enhet}</td>
                        <td class="num">${formatNok(r.budsjett)}</td>
                        <td class="num">${formatNok(r.regnskap)}</td>
                        <td class="num" style="color:${avvikColor}; font-weight:600;">${formatNok(r.avvik)}</td>
                        <td class="num" style="color:${avvikColor}; font-weight:600;">${r.avvikPct}</td>
                    </tr>
                `;
            });

            if (data.summary) {
                const s = data.summary;
                const sAvvikColor = s.avvik < 0 ? 'var(--alert-red)' : 'var(--navy-dark)';
                html += `
                    <tr class="summary-row">
                        <td>${s.title}</td>
                        <td>${s.enhet}</td>
                        <td class="num">${formatNok(s.budsjett)}</td>
                        <td class="num">${formatNok(s.regnskap)}</td>
                        <td class="num" style="color:${sAvvikColor};">${formatNok(s.avvik)}</td>
                        <td class="num" style="color:${sAvvikColor};">${s.avvikPct}</td>
                    </tr>
                `;
            }
            tbody.innerHTML = html;
        }

        function selectSector(sectorKey) {
            const data = SEKTOR_DATA[sectorKey] || SEKTOR_DATA["ALL"];

            // 0. Oppdater dynamisk KOSTRA artsavvik tabell for valgt virksomhetsområde
            if (typeof renderVariancesTable === 'function') {
                renderVariancesTable(sectorKey);
            }

            // 1. Oppdater aktive knapper i top sector-nav-bar
            const navButtons = document.querySelectorAll("#sector-nav-bar .sector-tab-btn");
            navButtons.forEach(btn => btn.classList.remove("active"));
            const activeNavBtn = document.getElementById(`sec-btn-${sectorKey.toLowerCase()}`) || document.getElementById("sec-btn-all");
            if (activeNavBtn) activeNavBtn.classList.add("active");

            // 2. Oppdater aktive lenker i sidebar
            const sideLinks = document.querySelectorAll("#hub-sidebar .sidebar-nav-item");
            sideLinks.forEach(link => {
                if (link.id && link.id.startsWith("side-sec-")) {
                    link.classList.remove("active");
                }
            });
            const sideIdMap = {
                "ALL": "side-sec-all",
                "HELSE": "side-sec-helse",
                "OPPVEKST": "side-sec-oppvekst",
                "BYUTVIKLING": "side-sec-by",
                "KULTUR": "side-sec-kultur",
                "ORG_TEK": "side-sec-org",
                "OKONOMI": "side-sec-oko"
            };
            const targetSideId = sideIdMap[sectorKey] || `side-sec-${sectorKey.toLowerCase()}`;
            const activeSideLink = document.getElementById(targetSideId);
            if (activeSideLink) activeSideLink.classList.add("active");

            // 2B. Oppdater dynamisk sidebar oversiktskort, totaler, MoM og linjediagram
            if (typeof updateSidebarOverview === 'function') {
                updateSidebarOverview(sectorKey);
            }

            // 3. Rendre Sektor Detaljkort
            const detailCard = document.getElementById("sector-detail-card");
            if (detailCard) {
                detailCard.innerHTML = `
                    <div class="sector-detail-header">
                        <div>
                            <div class="sector-detail-title">${data.icon} ${data.title}</div>
                            <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">
                                ${data.subtitle} | Ansvarlig rådgiver: <strong>${data.radgiver}</strong>
                            </div>
                        </div>
                        <span class="status-badge" style="font-size:11px; font-weight:700;">${data.status_badge}</span>
                    </div>

                    <div class="sector-detail-grid">
                        <div class="sector-field-box">
                            <strong>📌 Ansvarsområde</strong>
                            <p>${data.ansvarsomrade}</p>
                            <div style="margin-top:8px; font-size:11.5px; color:var(--text-secondary);">
                                <strong>🏛️ KOSTRA-funksjoner:</strong> ${data.kostra}
                            </div>
                        </div>
                        <div class="sector-field-box">
                            <strong>🎯 Målgruppe & Tjenestebrukere</strong>
                            <p>${data.malgruppe}</p>
                            <div style="margin-top:8px; font-size:11.5px; color:var(--text-secondary);">
                                <strong>⚡ Økonomisk Fokus & Tiltak:</strong> ${data.fokus}
                            </div>
                        </div>
                    </div>

                    <div class="sector-kpi-row">
                        <div class="sector-kpi-chip">
                            <div class="kpi-sub">Budsjettramme (BAC)</div>
                            <div class="kpi-num">${data.ramme}</div>
                        </div>
                        <div class="sector-kpi-chip">
                            <div class="kpi-sub">Hittil Påløpt (AC)</div>
                            <div class="kpi-num">${data.forbruk}</div>
                        </div>
                        <div class="sector-kpi-chip">
                            <div class="kpi-sub">Avvik YTD (CV)</div>
                            <div class="kpi-num" style="color:${data.avvik.includes('+') ? 'var(--alert-red)' : 'var(--navy-dark)'};">${data.avvik}</div>
                        </div>
                        <div class="sector-kpi-chip">
                            <div class="kpi-sub">Kostnadsindeks (CPI)</div>
                            <div class="kpi-num">${data.cpi}</div>
                        </div>
                    </div>
                    ${sectorKey === 'HELSE' ? `
                    <div style="margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px;">
                        <div style="background:#ffffff; border:1px solid var(--border-light); border-left:3px solid var(--accent-blue); padding:10px 14px; border-radius:3px;">
                            <div style="font-size:11px; font-weight:700; color:var(--navy-dark); display:flex; justify-content:space-between; align-items:center;">
