        <!-- 4-Punkts Avviks- og Effektprognose -->
        <div class="triage-card" style="border-left: 3px solid var(--navy-dark);">
            <div class="section-header" style="margin-bottom: 8px;">
                <span>📝 4-Punkts Avviks- og Effektprognose</span>
