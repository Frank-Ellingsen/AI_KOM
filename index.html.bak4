        let currentActivePhase = 2;

        function selectWorkflowPhase(phaseNum, shouldScroll = false) {
            currentActivePhase = phaseNum;

            // Oppdater stepper-kort
            for (let i = 1; i <= 5; i++) {
                const card = document.getElementById("cycle-card-" + i);
                const sideItem = document.getElementById("side-step-" + i);
                if (card) {
                    if (i === phaseNum) card.classList.add("active");
                    else card.classList.remove("active");
                }
                if (sideItem) {
                    if (i === phaseNum) sideItem.classList.add("active");
                    else sideItem.classList.remove("active");
                }
            }

            const pData = PHASE_CHECKLISTS[phaseNum];
            if (pData) {
                document.getElementById("current-phase-label").innerText = `Fase ${phaseNum}: ${pData.title.split(': ')[1] || ''}`;
                renderPhaseChecklist(phaseNum);
            }

            // Scroll relevant seksjon i syne basert på fasen kun ved eksplisitt klikk
            if (shouldScroll) {
                if (phaseNum === 2) {
                    document.getElementById("avvik-seksjon")?.scrollIntoView({ behavior: 'smooth' });
                } else if (phaseNum === 3) {
                    document.getElementById("triage-seksjon")?.scrollIntoView({ behavior: 'smooth' });
                } else if (phaseNum === 4) {
                    document.getElementById("kpi-seksjon")?.scrollIntoView({ behavior: 'smooth' });
                } else if (phaseNum === 5) {
                    document.getElementById("saksflyt")?.scrollIntoView({ behavior: 'smooth' });
                }
            }
        }

        function renderPhaseChecklist(phaseNum) {
            const p = PHASE_CHECKLISTS[phaseNum];
            if (!p) return;

            document.getElementById("checklist-title").innerText = p.title;

            // Hent lagrede sjekkbokser fra localStorage
            const savedState = JSON.parse(localStorage.getItem(`checklist_phase_${phaseNum}`) || "{}");

            const container = document.getElementById("checklist-items-container");
            container.innerHTML = "";

            let doneCount = 0;
            p.items.forEach((item, idx) => {
                const isChecked = savedState[item.id] !== undefined ? savedState[item.id] : item.done;
                if (isChecked) doneCount++;

                const row = document.createElement("div");
                row.className = "checklist-item";
                row.innerHTML = `
                    <input type="checkbox" id="chk_${item.id}" ${isChecked ? 'checked' : ''} onchange="toggleChecklistItem('${item.id}', ${phaseNum})">
                    <label for="chk_${item.id}" style="cursor:pointer; flex:1;">
                        <strong style="color:var(--navy-dark); font-family:var(--font-mono);">${item.code}:</strong> 
                        ${item.text}
                    </label>
                `;
                container.appendChild(row);
            });

            updateChecklistCounter(doneCount, p.items.length);
        }

        function toggleChecklistItem(itemId, phaseNum) {
            const chk = document.getElementById(`chk_${itemId}`);
            const savedState = JSON.parse(localStorage.getItem(`checklist_phase_${phaseNum}`) || "{}");
            savedState[itemId] = chk.checked;
            localStorage.setItem(`checklist_phase_${phaseNum}`, JSON.stringify(savedState));

            // Tell opp på nytt
            const p = PHASE_CHECKLISTS[phaseNum];
            let doneCount = 0;
            p.items.forEach(it => {
                const state = savedState[it.id] !== undefined ? savedState[it.id] : it.done;
                if (state) doneCount++;
            });
            updateChecklistCounter(doneCount, p.items.length);
        }

        function updateChecklistCounter(done, total) {
            const pct = Math.round((done / total) * 100);
            document.getElementById("checklist-counter").innerText = `${done} av ${total} oppgaver fullført (${pct} %)`;
            document.getElementById("checklist-progress").style.width = pct + "%";
            if (pct === 100) {
                document.getElementById("checklist-progress").style.background = "var(--success-green)";
            } else {
                document.getElementById("checklist-progress").style.background = "var(--navy-dark)";
            }
        }

        function markAllChecklistDone() {
            const p = PHASE_CHECKLISTS[currentActivePhase];
            const savedState = {};
            p.items.forEach(it => {
                savedState[it.id] = true;
                const el = document.getElementById(`chk_${it.id}`);
                if (el) el.checked = true;
            });
            localStorage.setItem(`checklist_phase_${currentActivePhase}`, JSON.stringify(savedState));
            updateChecklistCounter(p.items.length, p.items.length);
        }

        function resetCurrentChecklist() {
            localStorage.removeItem(`checklist_phase_${currentActivePhase}`);
            renderPhaseChecklist(currentActivePhase);
        }

        function toggleSidebar() {
            const sb = document.getElementById("hub-sidebar");
            sb.classList.toggle("open");
        }

        // 2. Brukerguide & Controller-Håndbok Modal
        const GUIDE_PAGES = {
            "START": `
                <h3>🏛️ Velkommen til Control Office Hub — Brukerveiledning</h3>
                <p>Dette verktøyet er utviklet for <strong>økonomirådgivere, controllere og virksomhetsledere i Kristiansand kommune</strong>. Det kombinerer kommunal regnskapskontroll (Visma Enterprise ERP), budsjett- og rammestyring (Framsikt EPM) og kildeforankret AI-beslutningsstøtte (Glass-Box RAG).</p>
                
                <h4>🎯 Hovedfunksjoner i huben:</h4>
                <div class="guide-card-grid">
                    <div class="guide-mini-card">
                        <strong>📅 1. Månedshjul & Tidslinje</strong>
                        Følg den månedlige arbeidsflyten fra dataimport (dag 1–5), avviksanalyse (dag 6–10), lederdialog (dag 11–18), prognosejustering (dag 19–24) til politisk sak (dag 25–30).
                    </div>
                    <div class="guide-mini-card">
                        <strong>🚨 2. Avviksdeteksjon & Triage</strong>
                        Automatisk screening av 16 enheter. Grønne enheter innenfor terskel batch-godkjennes med ett klikk, mens røde avvik (Enhet 202 og 401) isoleres for tiltaksplan.
                    </div>
                    <div class="guide-mini-card">
                        <strong>🤖 3. Glass-Box RAG & Juss</strong>
                        Lovverkshub som kobler økonomidata mot Kommuneloven (§ 14-5 og § 14-6), HTA § 4, KOSTRA-veileder og økonomireglement.
                    </div>
                    <div class="guide-mini-card">
                        <strong>🔒 4. Stage-Gate Port 9 & SHA-256</strong>
                        100 % Human-in-the-Loop. Ingen autonome beslutninger. Saksbehandler signerer med kryptografisk fingeravtrykk for revisjonen.
                    </div>
                </div>

                <h4>💡 Tips for effektiv navigasjon:</h4>
                <ul>
                    <li>Bruk <strong>venstre sidebar</strong> for å hoppe rett til den aktive fasen i måneden eller ønsket verktøy.</li>
                    <li>Hold musepekeren over ethvert nøkkeltall (f.eks. <span class="tufte-tip" data-tip="Cost Variance: Budsjett minus regnskap">CV</span> eller <span class="tufte-tip" data-tip="Cost Performance Index: Budsjetteffektivitet">CPI</span>) for å se formel og tolkning.</li>
                    <li>Åpne <strong>Gemini Flash EPM-chatten</strong> i høyre hjørne for å stille direkte spørsmål om tallene i databasen.</li>
                </ul>
            `,
            "MANED": `
                <h3>📅 Økonomirådgiverens Månedssyklus — Trinn-for-Trinn</h3>
                <p>I Kristiansand kommune følger økonomioppfølgingen et fast 30-dagers løp for hver regnskapsmåned (M1–M12) og tertial (T1 og T2):</p>
                
                <h4>Uke 1 (Dag 1–5): Månedsstart & Datagrunnlag</h4>
                <ul>
                    <li><strong>M-01:</strong> Bankavstemminger fullføres for alle driftskonti.</li>
                    <li><strong>M-02 & M-03:</strong> Mellomregninger avstemmes; lønn og A-melding verifiseres mot Skatteetatens kvittering.</li>
                    <li><strong>M-04:</strong> EHF-fakturaer med leveringsdato i måneden er godkjent og postert.</li>
                    <li><strong>M-05:</strong> Data vaskes for personopplysninger (PII) og synkroniseres til lokal Golden Record SQLite-database.</li>
                </ul>

                <h4>Uke 2 (Dag 6–10): Avviksanalyse & Zero-Click Triage</h4>
                <ul>
                    <li><strong>T-01:</strong> Faktisk regnskap sammenholdes mot periodisert budsjettramme fra Framsikt EPM.</li>
                    <li><strong>T-02:</strong> Sykepengerefusjoner fra NAV (art 1600) avstemmes for å unngå kunstige merforbruk på lønn.</li>
                    <li><strong>T-03:</strong> Dypdykk på art 1020 (Vikarer) og 1090 (Overtid) for skole og helse.</li>
                    <li><strong>T-04:</strong> Triage: 14 grønne enheter batch-godkjennes; Enhet 202 (Skole) og 401 (Helse) merkes for strakstiltak.</li>
                </ul>

                <h4>Uke 3 (Dag 11–18): Virksomhetsdialog & Partssamarbeid</h4>
                <ul>
                    <li>Gjennomgangsmøter med rektor (Enhet 202) og enhetsleder (Enhet 401).</li>
                    <li>Drøfting iht. <strong>HTA § 4</strong> med tillitsvalgte om vikarstopp og intern vikarpool.</li>
                    <li>Utarbeidelse av <strong>4-punkts avviks- og effektprognose</strong> (YTD avvik → Årsak → Tiltak → EOY balanse).</li>
                    <li>Stage-Gate Port 9 sign-off av controller.</li>
                </ul>

                <h4>Uke 4 (Dag 19–24): Helårsprognose (EAC / ETC)</h4>
                <ul>
                    <li>Etablere ny helårsprognose (Estimate at Completion / EAC) per 31.12.</li>
                    <li>Oppdatere Framsikt EPM med innarbeidede tiltakseffekter.</li>
                    <li>Kjøre Monte Carlo-simulering for å fastsette usikkerhetsspenn (P10/P50/P90).</li>
                </ul>

                <h4>Uke 5 (Dag 25–30): Politisk Rapportering & Vedtak</h4>
                <ul>
                    <li>Generere saksfremlegg til <strong>Formannskapet og Bystyret</strong> jf. Kommuneloven § 14-5.</li>
                    <li>Sikre at bruttoprinsippet (§ 14-6) er fulgt.</li>
                    <li>Kryptografisk forsegling med SHA-256 i <code>Audit_AI_Actions</code>.</li>
                    <li>Publisering i Public360.</li>
                </ul>
            `,
            "NOKKELTALL": `
                <h3>📊 Nøkkeltallsordbok & Earned Value Management (EVM)</h3>
                <p>Tabellene og KPI-kortene benytter standardiserte prosjekt- og virksomhetsstyringsmetrikker (ISO 21508 / FAST):</p>
                
                <table class="tufte-table" style="margin-top:12px;">
                    <thead>
                        <tr><th>Nøkkeltall</th><th>Fullt Navn</th><th>Formel</th><th>Tolkning & Terskel</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>PV</strong></td>
                            <td>Planlagt Verdi (Planned Value)</td>
                            <td><code>Periodisert Budsjett</code></td>
                            <td>Hva vi planla å bruke akkumulert frem til rapporteringstidspunktet.</td>
                        </tr>
                        <tr>
                            <td><strong>AC</strong></td>
                            <td>Påløpt Kostnad (Actual Cost)</td>
                            <td><code>Faktisk Regnskap</code></td>
                            <td>Reelle kostnader bokført i Visma Enterprise ERP.</td>
                        </tr>
                        <tr>
                            <td><strong>CV</strong></td>
                            <td>Kostnadsavvik (Cost Variance)</td>
                            <td><code>PV - AC</code></td>
                            <td><strong>Negativ verdi</strong> = Merforbruk (overskridelse).<br><strong>Positiv verdi</strong> = Mindreforbruk (innsparing).</td>
                        </tr>
                        <tr>
                            <td><strong>CPI</strong></td>
                            <td>Kostnadsindeks (Cost Perf. Index)</td>
                            <td><code>PV / AC</code></td>
                            <td><strong>CPI = 1.000:</strong> I perfekt rute.<br><strong>CPI < 1.000:</strong> Kronene renner ut raskere enn budsjettert (avviksalarm ved < 0.900).</td>
                        </tr>
                        <tr>
                            <td><strong>EAC</strong></td>
                            <td>Sluttprognose (Est. at Completion)</td>
                            <td><code>AC + ETC</code></td>
                            <td>Beregnet totalregnskap per 31.12. Viser forventet sluttavvik ved årsslutt.</td>
                        </tr>
                        <tr>
                            <td><strong>ETC</strong></td>
                            <td>Gjenstående Forbruk (Est. to Complete)</td>
                            <td><code>(BAC - EV) / CPI</code></td>
                            <td>Estimert kostnad for å fullføre resterende del av året.</td>
                        </tr>
                        <tr>
                            <td><strong>BAC</strong></td>
                            <td>Vedtatt Totalramme (Budget at Completion)</td>
                            <td><code>Årsbudsjett</code></td>
                            <td>Kommunestyrets opprinnelige bevilgning.</td>
                        </tr>
                    </tbody>
                </table>
            `,
            "KOSTRA": `
                <h3>🏛️ KOSTRA Struktur, Kontoplan & Feilposteringskontroll</h3>
                <p>I kommunal økonomi styres ressursene i et flerdimensjonalt kontosystem definert av Statistisk sentralbyrå (SSB):</p>
                
                <h4>1. Funksjon (Hvor brukes pengene?):</h4>
                <ul>
                    <li><strong>Funksjon 202:</strong> Grunnskoleopplæring (ordinær drift og lærere).</li>
                    <li><strong>Funksjon 222:</strong> Skolefritidsordning (SFO).</li>
                    <li><strong>Funksjon 254:</strong> Kommunal boenhet (bofellesskap og døgnturnus).</li>
                    <li><strong>Funksjon 261:</strong> Institusjonsomsorg og sykehjem.</li>
                </ul>

                <h4>2. Art (Hva slags ressurs er kjøpt?):</h4>
                <ul>
                    <li><strong>Art 1010:</strong> Fast lønn til lærere og faste stabsstillinger.</li>
                    <li><strong>Art 1020:</strong> Lønn til sykevikarer og timelærere (kritisk risikopost).</li>
                    <li><strong>Art 1040 / 1090:</strong> Overtid, helgetillegg og ulempetillegg.</li>
                    <li><strong>Art 1270:</strong> Kjøp av konsulentbistand, advokattjenester og vikarbyråer.</li>
                    <li><strong>Art 1600 / 1690:</strong> Refusjon for sykepenger fra NAV (bruttoføring jf. § 14-6).</li>
                </ul>

                <h4>⚠️ Kritiske Feilposteringsregler:</h4>
                <ul>
                    <li><strong>Bruttoprinsippet (Kommuneloven § 14-6):</strong> Utgifter til vikarer (art 1020) og refusjon fra NAV (art 1600) skal ALDRI nettes mot hverandre. De skal føres brutto.</li>
                    <li><strong>Periodiseringskrav:</strong> Manglende fakturaer eller opptjente sykepenger per månedsslutt må periodiseres for å gi et rettvisende avviksbilde.</li>
                </ul>
            `,
            "JUSS": `
                <h3>⚖️ Juridiske Rammer, Stage-Gate Port 9 & SHA-256</h3>
                <p>Offentlig forvaltning har strenge lovkrav til likebehandling, innsyn og menneskelig kontroll:</p>

                <h4>1. Kommuneloven § 14-5 (Budsjettbalanse & Handleplikt):</h4>
                <p>Dersom det oppstår vesentlige avvik i løpet av året som truer budsjettbalansen, har kommunedirektøren en <strong>lovfestet handleplikt</strong> til å fremme sak om endring av årsbudsjettet for Bystyret. I Kristiansand kommune utløses formell sak ved sektoravvik > 5 mill. kr.</p>

                <h4>2. Hovedtariffavtalen (HTA) § 4 (Partssamarbeid):</h4>
                <p>Arbeidsgiver plikter å drøfte endringer i bemanningsplaner, turnusjusteringer, overtidsstopp og vikarbyråbegrensninger med tillitsvalgte (Fagforbundet, Delta, NSF, Utdanningsforbundet) FØR tiltakene iverksettes.</p>

                <h4>3. EU AI Act Art. 14 & GDPR Art. 22 (Human-in-the-Loop):</h4>
                <p>AI-systemet gir kun forslag og beslutningsstøtte. <strong>Ingen autonome vedtak</strong> kan fattes. En autorisert saksbehandler (Frank Ellingsen) må aktivt godkjenne, modifisere eller avvise anbefalingen i <em>Stage-Gate Port 9</em>.</p>

                <h4>4. Kryptografisk Forsegling (SHA-256):</h4>
                <p>Hver godkjent handling lagres i <code>Audit_AI_Actions</code> med en uforanderlig SHA-256 hash. Dette gir Kommunerevisjonen og Kontrollutvalget ugjendrivelig bevis på at saksgrunnlaget ikke er manipulert i ettertid.</p>
            `,
            "TUFTE": `
                <h3>📈 Edward Tuftes Data-Ink Standard i Praksis</h3>
                <p>Dette dashbordet er utformet strengt etter Edward Tuftes anerkjente prinsipper for <em>Data-Ink Ratio</em>:</p>
                
                <h4>Hovedprinsipper implementert:</h4>
                <ol>
                    <li><strong>Fjern vertikale linjer i tabeller:</strong> Vertikale streker skaper visuell støy som distraherer øyet fra tallenes mønstre. Kun tynne horisontale linjer benyttes.</li>
                    <li><strong>Ingen tunge skygger eller unødvendige ikoner:</strong> Bakgrunner holdes nøytrale (#ffffff og #fbfbfb). Møysommelig unngått dekorativ grafikk.</li>
                    <li><strong>Høyrejusterte tall med fast bredde:</strong> Alle tall er høyrejustert og bruker monospace-skrifttype, slik at desimaler og siffer står nøyaktig under hverandre for umiddelbar sammenligning.</li>
                    <li><strong>Venstrejustert tekst:</strong> Tekstkolonner og kontobeskrivelser er venstrejustert for optimal lesbarhet.</li>
                    <li><strong>Dempede farger — Rød og amber kun for reell risiko:</strong> Farge brukes utelukkende semantisk. Rød (<span style="color:var(--alert-red); font-weight:700;">#c0392b</span>) betyr aktiv overskridelse som krever handling; amber betyr advarsel; grønn betyr at alt er innenfor terskel.</li>
                </ol>
            `
        };

        function openUserGuide(tabKey) {
            switchGuideTab(tabKey || 'START');
            document.getElementById("userguide-modal").style.display = "flex";
        }

        function closeUserGuide() {
            document.getElementById("userguide-modal").style.display = "none";
        }

        function closeUserGuideOnBackdrop(e) {
            if (e.target.id === "userguide-modal") {
                closeUserGuide();
            }
        }

        function switchGuideTab(tabKey) {
            const tabs = document.querySelectorAll(".guide-tabs .guide-tab-btn");
            tabs.forEach(t => t.classList.remove("active"));

            // Finn rett knapp
            tabs.forEach(t => {
                const oc = t.getAttribute("onclick") || "";
                if (oc.includes(`'${tabKey}'`)) {
                    t.classList.add("active");
                }
            });

            const contentArea = document.getElementById("guide-tab-content");
            contentArea.innerHTML = GUIDE_PAGES[tabKey] || GUIDE_PAGES["START"];
        }

        /* ==========================================================================
           UX ENHANCEMENTS: COMMAND PALETTE, FRAMSIKT/TSV EXPORT, SIMULATOR & PRES.
           ========================================================================== */

        // 1. Toast Notification
        function showToast(msg) {
            const toast = document.getElementById("hub-toast");
            if (!toast) return;
            toast.innerText = msg;
            toast.style.display = "flex";
            clearTimeout(window._toastTimeout);
            window._toastTimeout = setTimeout(() => {
                toast.style.display = "none";
            }, 3000);
        }

