                        { id: "ACT-KORT-DIR-K01", title: "Fremme sak til Formannskapet om 2. tertialrapport med tiltakspakke", owner: "Kommunedirektør", deadline: "28. okt 2026", impact: "Rebalanserer 94.9M", legal: "Kommuneloven § 14-5", status: "🏛️ Fremmet" },
                        { id: "ACT-KORT-DIR-K02", title: "Konsernovergripende ansettelses- og konsulentstopp i staber", owner: "Kommunedirektør", deadline: "Umiddelbart", impact: "-13 000 000 kr EOY", legal: "Kommuneloven § 13-1", status: "🟢 Iverksatt" }
                    ],
                    longTermActions: [
                        { id: "ACT-LANG-DIR-K01", title: "Handlings- og økonomiplan (HØP) 2027–2030 med strukturelle kutt", owner: "Kommunedirektør / Bystyret", deadline: "Desember 2026", impact: "-45 000 000 kr/år", legal: "Kommuneloven § 14-4", status: "🟢 Pågår" },
                        { id: "ACT-LANG-DIR-K02", title: "Vern av disposisjonsfond over 6.0 % handlingsregel (unngå ROBEK)", owner: "Finansdirektør", deadline: "Flerårig", impact: "Buffer +50.8 MNOK", legal: "Kommuneloven § 14-5", status: "🟢 Sikret" }
                    ],
                    legalCheck: [
                        { rule: "Kommuneloven § 14-5", status: "OK", desc: "Lovfestet handleplikt er oppfylt; tiltakspakke lukker avviket før årsslutt." },
                        { rule: "Kommuneloven § 14-6", status: "OK", desc: "Bruttoprinsippet overholdes; alle sektorer rapporteres brutto." },
                        { rule: "ROBEK-sikring", status: "OK", desc: "Disposisjonsfondet på 485 MNOK (6.7 %) sikrer kommunen mot statlig kontroll." },
                        { rule: "Port 9 HITL", status: "OK", desc: "Attestert og forseglet med SHA-256." }
                    ]
                }
            }
        };

        // Fallback for "ALL" maps to "OKONOMI"
        MEETING_PACKS["ALL"] = MEETING_PACKS["OKONOMI"];

        function switchMeetingLevel(levelKey) {
            currentMeetingLevel = levelKey;
            
            // Oppdater aktive knapper i level-pills-bar
            const btns = document.querySelectorAll("#level-pills-bar .level-pill-btn");
            btns.forEach(b => b.classList.remove("active"));
            
            const activeBtn = document.getElementById(`btn-lvl-${levelKey.toLowerCase()}`);
            if (activeBtn) activeBtn.classList.add("active");
            
            renderMeetingPack(currentMeetingSector, currentMeetingLevel);
            
            const levelLabel = levelKey === 'NIVA1' ? 'Nivå 1: Avdelings- / Seksjonsleder' : (levelKey === 'NIVA2' ? 'Nivå 2: Kommunalsjef' : 'Nivå 3: Kommunaldirektør');
            showToast(`👥 Viser møterapport for ${levelLabel}`);
        }

        function renderMeetingPack(sectorKey, levelKey) {
            const secKey = sectorKey || currentMeetingSector || "ALL";
            const lvlKey = levelKey || currentMeetingLevel || "NIVA1";
            currentMeetingSector = secKey;
            currentMeetingLevel = lvlKey;

            const secPacks = MEETING_PACKS[secKey] || MEETING_PACKS["ALL"];
            const pack = secPacks[lvlKey] || secPacks["NIVA1"];
            const sectorData = SEKTOR_DATA[secKey] || SEKTOR_DATA["ALL"];

            const container = document.getElementById("meeting-main-card");
            if (!container) return;

            // Oppdater seksjons-badge
            const badgeEl = document.getElementById("meeting-header-badge");
            if (badgeEl) {
                const shortTitle = sectorData.title.includes('—') ? sectorData.title.split('—')[0].trim() : sectorData.title;
                badgeEl.textContent = `${sectorData.icon} ${shortTitle} | ${pack.levelTitle.split(':')[0]} | M10`;
            }

            container.innerHTML = `
                <!-- 1. Møteoverskrift Hero -->
                <div class="meeting-hero-header">
                    <div>
                        <div style="font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-secondary); font-weight:700;">
                            ${sectorData.icon} ${sectorData.title} &bull; ${pack.levelTitle}
                        </div>
                        <div class="meeting-title" style="margin-top:2px;">
                            ${pack.unitName}
                        </div>
                        <div style="font-size:12px; color:var(--text-secondary); margin-top:2px;">
                            ${pack.cadence}
                        </div>
                    </div>
                    <div>
                        <span class="status-badge" style="background:${pack.statusColor === 'var(--alert-red)' ? '#fee2e2' : (pack.statusColor === 'var(--alert-amber)' ? '#fef3c7' : '#dcfce7')}; color:${pack.statusColor === 'var(--alert-red)' ? '#991b1b' : (pack.statusColor === 'var(--alert-amber)' ? '#92400e' : '#166534')}; font-size:11px; font-weight:700;">
                            ${pack.statusBadge}
                        </span>
                    </div>
                </div>

                <!-- 2. Møtemetadata Grid -->
                <div class="meeting-meta-grid">
                    <div class="meeting-meta-item">
                        <strong>👔 Økonomirådgiver / Møteleder</strong>
                        ${pack.advisor}
                    </div>
                    <div class="meeting-meta-item">
                        <strong>👤 Budsjettansvarlig Leder</strong>
                        ${pack.leader}
                    </div>
                    <div class="meeting-meta-item">
                        <strong>📅 Kadens & Rapporteringstermin</strong>
                        ${pack.cadence}
                    </div>
                    <div class="meeting-meta-item">
                        <strong>⚖️ Lovhjemmel & Styringskrav</strong>
                        ${pack.hjemmel}
                    </div>
                </div>

                <!-- 3. EVM Nøkkeltall for Møtet -->
                <div class="meeting-kpi-row">
                    <div class="meeting-kpi-chip">
                        <div class="kpi-sub">Budsjettramme (BAC)</div>
                        <div class="kpi-num">${pack.kpis.bac}</div>
                    </div>
                    <div class="meeting-kpi-chip">
                        <div class="kpi-sub">Hittil Påløpt (AC)</div>
                        <div class="kpi-num">${pack.kpis.ac}</div>
                    </div>
                    <div class="meeting-kpi-chip">
                        <div class="kpi-sub">Avvik YTD (CV)</div>
                        <div class="kpi-num" style="color:${pack.kpis.cvAlert ? 'var(--alert-red)' : 'var(--navy-dark)'};">${pack.kpis.cv}</div>
                    </div>
                    <div class="meeting-kpi-chip">
                        <div class="kpi-sub">Kostnadsindeks (CPI)</div>
                        <div class="kpi-num" style="color:${pack.kpis.cpiAlert ? 'var(--alert-red)' : 'var(--navy-dark)'};">${pack.kpis.cpi}</div>
                    </div>
                    <div class="meeting-kpi-chip">
                        <div class="kpi-sub">Sluttprognose (EAC)</div>
                        <div class="kpi-num">${pack.kpis.eac}</div>
                    </div>
                    <div class="meeting-kpi-chip" style="background:#f0fdf4; border-color:#bbf7d0;">
                        <div class="kpi-sub" style="color:#166534;">Simulert EOY m/ Tiltak</div>
                        <div class="kpi-num" style="color:#15803d; font-size:12.5px;">${pack.kpis.eacSim}</div>
                    </div>
                </div>

                <!-- 4. KOSTRA Artsavvik & Kostnadsdrivere -->
                <div class="meeting-section-box">
                    <h4>
                        <span>🚨 Kritiske Linjeavvik på Kontonivå (Visma ERP Transaksjonsdata)</span>
                        <span style="font-size:11px; font-weight:normal; color:var(--text-secondary);">KOSTRA funksjon & art</span>
                    </h4>
                    <table class="tufte-table" style="font-size:11.5px;">
                        <thead>
                            <tr>
                                <th>Konto / Art</th>
                                <th>Betegnelse</th>
                                <th class="num">Budsjett YTD</th>
                                <th class="num">Regnskap YTD</th>
                                <th class="num">Avvik (kr & %)</th>
                                <th>Årsak / Diagnostisk Rotårsak (RAG Glass-Box)</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${pack.variances.map(v => `
                                <tr>
                                    <td><strong>${v.art}</strong></td>
                                    <td>${v.desc}</td>
                                    <td class="num">${v.budget}</td>
                                    <td class="num">${v.actual}</td>
                                    <td class="num" style="color:${v.varNok.startsWith('+') ? 'var(--alert-red)' : 'var(--success-green)'}; font-weight:700;">
                                        ${v.varNok} (${v.varPct})
                                    </td>
                                    <td style="color:var(--text-secondary);">${v.driver}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>

                <!-- 5. Konkrete Tiltak for å nå Balanse EOY (To tabeller: Kort- og Langsiktige) -->
                <div style="display:grid; grid-template-columns:1fr; gap:14px; margin-bottom:16px;">
                    <!-- A. Kortsiktige Tiltak (0–3 måneder) -->
                    <div class="meeting-section-box" style="border-left:3px solid var(--accent-blue);">
                        <h4>
                            <span>⚡ Kortsiktige Tiltak (0–3 måneder / Operative Strakstiltak)</span>
                            <span class="status-badge" style="background:#e0f2fe; color:#0369a1; font-size:10px;">Umiddelbar effekt</span>
                        </h4>
                        <p style="font-size:11.5px; color:var(--text-secondary); margin-bottom:10px;">
                            Administrativt gjennomførbare tiltak for rask kostnadsreduksjon og likviditetsforbedring uten krav om lovendringer eller politisk behandling.
                        </p>
                        <table class="tufte-table" style="font-size:11.5px;">
                            <thead>
                                <tr>
                                    <th>Tiltak ID</th>
                                    <th>Konkret Handlingspunkt & Beskrivelse</th>
                                    <th>Ansvarlig</th>
                                    <th>Frist</th>
                                    <th class="num">Estimert Effekt</th>
                                    <th>Hjemmel / Forankring</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${pack.shortTermActions.map(a => `
                                    <tr>
                                        <td><code>${a.id}</code></td>
                                        <td><strong>${a.title}</strong></td>
                                        <td>${a.owner}</td>
                                        <td>${a.deadline}</td>
                                        <td class="num" style="color:var(--success-green); font-weight:700;">${a.impact}</td>
                                        <td style="font-size:11px; color:var(--text-secondary);">${a.legal}</td>
                                        <td><span class="status-badge" style="font-size:10px;">${a.status}</span></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>

                    <!-- B. Langsiktige Tiltak (4–12 måneder / Strukturelle) -->
                    <div class="meeting-section-box" style="border-left:3px solid var(--navy-dark);">
                        <h4>
                            <span>🌱 Langsiktige Tiltak (4–12 måneder / Strukturelle Omstillinger)</span>
                            <span class="status-badge" style="background:#f1f5f9; color:var(--navy-dark); font-size:10px;">Varig effekt</span>
                        </h4>
                        <p style="font-size:11.5px; color:var(--text-secondary); margin-bottom:10px;">
                            Strukturelle og organisatoriske reformer som krever partssamarbeid (HTA § 4), bemanningsplanendringer eller sak til Formannskapet/Bystyret.
                        </p>
                        <table class="tufte-table" style="font-size:11.5px;">
                            <thead>
                                <tr>
                                    <th>Tiltak ID</th>
                                    <th>Strukturelt Omstillingstiltak</th>
                                    <th>Ansvarlig</th>
                                    <th>Frist</th>
                                    <th class="num">Helårseffekt</th>
                                    <th>Hjemmel / Forankring</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${pack.longTermActions.map(a => `
                                    <tr>
                                        <td><code>${a.id}</code></td>
                                        <td><strong>${a.title}</strong></td>
                                        <td>${a.owner}</td>
                                        <td>${a.deadline}</td>
                                        <td class="num" style="color:var(--success-green); font-weight:700;">${a.impact}</td>
                                        <td style="font-size:11px; color:var(--text-secondary);">${a.legal}</td>
                                        <td><span class="status-badge" style="font-size:10px;">${a.status}</span></td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 6. Juridisk Rammevurdering & Lovlighetssjekk -->
                <div class="meeting-section-box">
                    <h4>
                        <span>⚖️ Juridiske Rammer & Lovlighetssjekk (Statutory Compliance Matrix)</span>
                        <span class="status-badge" style="background:#dcfce7; color:#15803d; font-size:10px;">🟢 100 % LOVLIG</span>
                    </h4>
                    <div class="compliance-grid">
                        ${pack.legalCheck.map(c => `
                            <div class="compliance-card">
                                <strong>✓ ${c.rule}</strong>
                                <span style="font-size:11px; color:var(--text-secondary);">${c.desc}</span>
                            </div>
                        `).join('')}
                    </div>
                </div>

                <!-- 7. Møteverktøylinje -->
                <div class="meeting-actions-toolbar">
                    <button class="btn btn-sm btn-primary" onclick="copyMeetingMemoToClipboard()" title="Kopier strukturert møtenotat til utklippstavlen for liming inn i Framsikt eller Visma">
                        📋 Kopier Møtenotat til Framsikt
                    </button>
                    <button class="btn btn-sm" onclick="previewDocument('${pack.docKey}')" title="Åpne fullstendig månedsrapport i lesevisning">
                        📄 Forhåndsvis Full Månedsrapport
                    </button>
                    <button class="btn btn-sm" onclick="signMeetingPackHITL('${secKey}', '${lvlKey}')" title="Signer med Stage-Gate Port 9 SHA-256 kryptografisk revisjonsstempel">
                        🔒 Stage-Gate Port 9 Sign-Off
                    </button>
                    <a href="${pack.docxFile}" download class="btn btn-sm" title="Last ned offisiell Word (.docx) mal for dette nivået">
                        ⬇️ Last ned Word Mal (.docx)
                    </a>
                    <button class="btn btn-sm" onclick="togglePresentationMode()" title="Aktiver fullskjerm møtemodus for visning i storskjerm">
                        🖥️ Møtemodus
                    </button>
                    <span id="meeting-sign-badge" style="font-size:11px; font-family:var(--font-mono); margin-left:auto; color:var(--text-secondary);">
                        Status: Venter på møtesignering
                    </span>
                </div>
            `;
        }

        function copyMeetingMemoToClipboard() {
            const secKey = currentMeetingSector || "ALL";
            const lvlKey = currentMeetingLevel || "NIVA1";
            const secPacks = MEETING_PACKS[secKey] || MEETING_PACKS["ALL"];
            const pack = secPacks[lvlKey] || secPacks["NIVA1"];
            const sectorData = SEKTOR_DATA[secKey] || SEKTOR_DATA["ALL"];

            const now = new Date().toISOString().slice(0, 10);
            const memoText = 
`================================================================================
KRISTIANSAND KOMMUNE — MÅNEDLIG MØTENOTAT FOR BUDSJETTANSVARLIG
================================================================================
Møtetype: ${pack.cadence}
Nivå: ${pack.levelTitle}
Virksomhetsområde: ${sectorData.title}
Enhet / Sektor: ${pack.unitName}
Møteleder / Controller: ${pack.advisor}
Budsjettansvarlig: ${pack.leader}
Dato: ${now}
Hjemmel: ${pack.hjemmel}
Status: ${pack.statusBadge}

--------------------------------------------------------------------------------
1. STATUS & EVM NØKKELTALL (PER 31.12):
--------------------------------------------------------------------------------
* Budsjettramme (BAC):         ${pack.kpis.bac}
* Hittil påløpt regnskap (AC):  ${pack.kpis.ac}
* Avvik hittil i år (CV):       ${pack.kpis.cv}
* Kostnadsindeks (CPI):         ${pack.kpis.cpi}
* Sluttprognose (EAC):          ${pack.kpis.eac}
* Estimert sluttavvik (VAC):    ${pack.kpis.vac}
* Simulert EOY m/ tiltak:       ${pack.kpis.eacSim}

--------------------------------------------------------------------------------
2. IDENTIFISERTE KRITISKE ARTSAVVIK & ROTÅRSAKER:
--------------------------------------------------------------------------------
${pack.variances.map(v => `* Art ${v.art} (${v.desc}): Avvik ${v.varNok} (${v.varPct})
  Årsak: ${v.driver}`).join('\n')}

--------------------------------------------------------------------------------
3. VEDTATTE KORTSIKTIGE TILTAK (0–3 MND / OPERATIVE STRAKSTILTAK):
--------------------------------------------------------------------------------
${pack.shortTermActions.map(a => `* [${a.id}] ${a.title}
  Ansvarlig: ${a.owner} | Frist: ${a.deadline} | Effekt: ${a.impact}
  Hjemmel: ${a.legal} | Status: ${a.status}`).join('\n')}

--------------------------------------------------------------------------------
4. PLANLAGTE LANGSIKTIGE TILTAK (4–12 MND / STRUKTURELLE OMSTILLINGER):
--------------------------------------------------------------------------------
${pack.longTermActions.map(a => `* [${a.id}] ${a.title}
  Ansvarlig: ${a.owner} | Frist: ${a.deadline} | Helårseffekt: ${a.impact}
  Hjemmel: ${a.legal} | Status: ${a.status}`).join('\n')}

--------------------------------------------------------------------------------
5. JURIDISK RAMMEVURDERING & LOVLIGHETSSJEKK:
--------------------------------------------------------------------------------
${pack.legalCheck.map(c => `* ${c.rule}: ${c.desc}`).join('\n')}

--------------------------------------------------------------------------------
6. STAGE-GATE PORT 9 ATTESTASJON:
--------------------------------------------------------------------------------
Saksbehandler: Frank Ellingsen (Senior Controller)
Attestert: JA jf. EU AI Act Art. 14 (Human Oversight) & Kommuneloven § 14-5
SHA-256 Revisjonskvittering genereres ved elektronisk sign-off i Office Hub.
================================================================================`;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(memoText).then(() => {
                    showToast("📋 Møtenotat kopiert til utklippstavlen! Klar for Framsikt/Visma.");
                }).catch(() => {
                    fallbackCopyMeetingMemo(memoText);
                });
            } else {
                fallbackCopyMeetingMemo(memoText);
            }
        }

        function fallbackCopyMeetingMemo(text) {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try {
                document.execCommand("copy");
                showToast("📋 Møtenotat kopiert til utklippstavlen!");
            } catch(e) {
                showToast("Feil ved kopiering til utklippstavle");
            }
            document.body.removeChild(ta);
        }

        async function signMeetingPackHITL(sectorKey, levelKey) {
            const secKey = sectorKey || currentMeetingSector || "ALL";
            const lvlKey = levelKey || currentMeetingLevel || "NIVA1";
            const secPacks = MEETING_PACKS[secKey] || MEETING_PACKS["ALL"];
            const pack = secPacks[lvlKey] || secPacks["NIVA1"];
            const now = new Date().toISOString();

            const payload = `MOTE_PORT9|${secKey}|${lvlKey}|${pack.unitName}|${pack.kpis.cv}|Frank Ellingsen|${now}`;
            const hash = await computeSHA256(payload);

            auditLogEntries.push({
                timestamp: now,
                query: `Møterapport ${pack.levelTitle} - ${pack.unitName}`,
                action: "APPROVED_MOTE_PORT9",
                user: "Frank Ellingsen",
                notes: `Månedsmøte godkjent. Kortsiktige og langsiktige tiltak forankret jf. Kommuneloven § 14-5. EOY balanse verifisert.`,
                hash: hash
            });

            const badge = document.getElementById("meeting-sign-badge");
            if (badge) {
                badge.innerHTML = `<span style="color:var(--success-green); font-weight:700;">✓ Forseglet i Stage-Gate Port 9</span> | <code>SHA256:${hash.slice(0, 16)}...</code>`;
            }

            showToast(`🔒 Møtepakke forseglet i Port 9! SHA-256: ${hash.slice(0, 16)}...`);
        }

        // 3. Command Palette (Ctrl+K)
        function openCommandPalette() {
            const modal = document.getElementById("cmd-palette-modal");
            if (modal) {
                modal.style.display = "flex";
                const inp = document.getElementById("cmd-palette-input");
                if (inp) {
                    inp.value = "";
                    filterCommandPalette("");
                    setTimeout(() => inp.focus(), 50);
                }
            }
        }

        function closeCommandPalette() {
            const modal = document.getElementById("cmd-palette-modal");
            if (modal) modal.style.display = "none";
        }

        function closeCommandPaletteOnBackdrop(e) {
            if (e.target.id === "cmd-palette-modal") {
                closeCommandPalette();
            }
        }

        function filterCommandPalette(query) {
            const q = query.toLowerCase().trim();
            const items = document.querySelectorAll("#cmd-palette-list .cmd-palette-item");
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = (!q || text.includes(q)) ? "flex" : "none";
            });
        }

        function executeCommand(cmd) {
            closeCommandPalette();
            if (cmd === 'SEC_HELSE') {
                selectSector('HELSE');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'SEC_OPPVEKST') {
                selectSector('OPPVEKST');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'SEC_BY') {
                selectSector('BYUTVIKLING');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'SEC_KULTUR') {
                selectSector('KULTUR');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'SEC_ORG') {
                selectSector('ORG_TEK');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'SEC_OKO') {
                selectSector('OKONOMI');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'ENHET_202') {
                loadTriageUnit('ENHET_202');
                const el = document.getElementById("triage-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("📍 Viser Enhet 202 Lovisenlev Skole i avvikstriagen");
            } else if (cmd === 'ENHET_401') {
                loadTriageUnit('ENHET_401');
                const el = document.getElementById("triage-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("📍 Viser Enhet 401 Helse & Mestring i avvikstriagen");
            } else if (cmd === 'MOTE_NIVA1') {
                switchMeetingLevel('NIVA1');
                const el = document.getElementById("mote-rapportering-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'MOTE_NIVA2') {
                switchMeetingLevel('NIVA2');
                const el = document.getElementById("mote-rapportering-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'MOTE_NIVA3') {
                switchMeetingLevel('NIVA3');
                const el = document.getElementById("mote-rapportering-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'RAG_14_5') {
                const inp = document.getElementById("rag-input");
                if (inp) inp.value = "Kommuneloven § 14-5";
                executeMockRAG();
                const el = document.getElementById("rag-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'RAG_14_6') {
                const inp = document.getElementById("rag-input");
                if (inp) inp.value = "Kommuneloven § 14-6 bruttoprinsippet";
                executeMockRAG();
                const el = document.getElementById("rag-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'MAL_SAKSFREMLEGG') {
                previewDocument('SAKSFREMLEGG');
            } else if (cmd === 'MAL_4PUNKT') {
                previewDocument('RAPPORT_MONSTER');
            } else if (cmd === 'MAL_HTA') {
                previewDocument('HTA_PROTOKOLL');
            } else if (cmd === 'HTA_4') {
                switchSimulatorUnit('HELSE');
                const el = document.getElementById("tiltak-simulator-card");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("🏥 Åpnet Døgnpleie Turnus- og Bemanningssimulator jf. HTA § 4");
            } else if (cmd === 'TOPP_FINANS' || cmd === 'SSHF_SAM') {
                selectSector('HELSE');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("🏥 Viser Toppfinansiering og SSHF Samhandlingsbarometer");
            } else if (cmd === 'HELSEPERSONELL_4') {
                const inp = document.getElementById("rag-input");
                if (inp) inp.value = "Helsepersonelloven § 4 forsvarlig bemanning";
                executeMockRAG();
                const el = document.getElementById("rag-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
            } else if (cmd === 'LAERERNORM' || cmd === 'BARNEHAGE_TILSKUDD' || cmd === 'NAV_RADAR') {
                selectSector('OPPVEKST');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("🏫 Viser Lærernorm, Barnehagetilskudd og NAV-refusjonsradar");
            } else if (cmd === 'VAR_SELVKPOST' || cmd === 'BYGGESAK_GEBYR' || cmd === 'KS2_INNVESTERING') {
                selectSector('BYUTVIKLING');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("💧 Viser VAR-Selvkost, Byggesaksgebyr og KS2 Gatekeeper");
            } else if (cmd === 'FRIVILLIGHET_TILSKUDD' || cmd === 'ENERGI_IDRETT') {
                selectSector('KULTUR');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("🎭 Viser Frivillighetstilskudd og Energibuffer for Idrettsbygg");
            } else if (cmd === 'FINOPS_SAAS' || cmd === 'KONSULENT_KUTT') {
                selectSector('ORG_TEK');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("💻 Viser FinOps Lisensmonitor og Konsulentkonvertering");
            } else if (cmd === 'RENTERISIKO' || cmd === 'PENSJON_AVVIK' || cmd === 'DISPOSISJONSFOND') {
                selectSector('OKONOMI');
                const el = document.getElementById("sektor-seksjon");
                if (el) el.scrollIntoView({ behavior: "smooth" });
                showToast("📈 Viser Renterisiko, Pensjonspremieavvik og Disposisjonsfond");
            } else if (cmd === 'COPY_FRAMSIKT') {
                copyToFramsiktFormat();
            } else if (cmd === 'COPY_TSV') {
                copyTriageTableAsTSV();
            } else if (cmd === 'TOGGLE_PRES') {
                togglePresentationMode();
            } else if (cmd === 'CHAT_AI') {
                toggleChatDrawer();
            }
        }

        // 3. Framsikt & Excel TSV Eksport
        function copyToFramsiktFormat() {
            const title = document.getElementById("rep4-active-title") ? document.getElementById("rep4-active-title").innerText : "Enhet 202";
            const p1 = document.getElementById("rep4-p1") ? document.getElementById("rep4-p1").innerText : "";
            const p2 = document.getElementById("rep4-p2") ? document.getElementById("rep4-p2").innerText : "";
            const p3 = document.getElementById("rep4-p3") ? document.getElementById("rep4-p3").innerText : "";
            const p4 = document.getElementById("rep4-p4") ? document.getElementById("rep4-p4").innerText : "";

            const framsiktText = 
`=== FRAMSIKT EPM AVVIKSKOMMENTAR ===
Enhet: ${title}
Saksbehandler: Frank Ellingsen (Senior Controller)
Dato: ${new Date().toISOString().slice(0, 10)}
Rapporteringstermin: 2. Tertial 2026

1. AVVIK HITTIL I ÅR (YTD):
${p1}

2. ÅRSAK TIL AVVIK:
${p2}

3. FORESLÅTTE TILTAK & HANDLINGSPLAN:
${p3}

4. KVANTIFISERT EFFEKT & EOY BALANSE:
${p4}

Internkontroll: Vurdert mot Kommuneloven § 14-5 & § 14-6 (SHA-256 forseglet).`;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(framsiktText).then(() => {
                    showToast("📋 4-punkts avviksnotat kopiert i Framsikt EPM-format!");
                });
            } else {
                showToast("✓ Framsikt-tekst generert.");
            }
        }

        function copyTriageTableAsTSV() {
            const tsvData = 
`Enhet\tHittil Faktisk (NOK)\tPeriodisert Budsjett (NOK)\tAvvik (NOK)\tAvvik (%)\tStatus
Enhet 202 Lovisenlev Skole\t11240000,00\t10000000,00\t1240000,00\t12,4 %\tKRITISK
Enhet 401 Helse & Mestring\t14750000,00\t13900000,00\t850000,00\t6,1 %\tADVARSEL
14 Øvrige Enheter (Snitt)\t165400000,00\t166200000,00\t-800000,00\t-0,5 %\tNORMAL`;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(tsvData).then(() => {
                    showToast("📊 Regnskapstall kopiert som Excel TSV (tabulatorseparert med norsk komma)!");
                });
            }
        }

        // 4. Interaktiv Tiltakssimulator (Dual & Multi: Skole, Helse, VAR, FinOps, Konsern)
        let currentSimulatorUnit = 'SKOLE';

        function switchSimulatorUnit(unitMode) {
            currentSimulatorUnit = unitMode;
            
            const tabButtons = {
                'SKOLE': document.getElementById("sim-tab-skole"),
                'HELSE': document.getElementById("sim-tab-helse"),
                'VAR': document.getElementById("sim-tab-var"),
                'FINOPS': document.getElementById("sim-tab-finops"),
                'FINANS': document.getElementById("sim-tab-finans")
            };

            Object.keys(tabButtons).forEach(k => {
                const btn = tabButtons[k];
                if (!btn) return;
                if (k === unitMode) {
                    btn.className = "btn btn-sm btn-primary";
                    btn.style.background = "var(--navy-dark)";
                    btn.style.borderColor = "var(--navy-dark)";
                    btn.style.color = "#ffffff";
                } else {
                    btn.className = "btn btn-sm";
                    btn.style.background = "#f1f5f9";
                    btn.style.borderColor = "#cbd5e1";
                    btn.style.color = "var(--text-primary)";
                }
            });

            const titleEl = document.getElementById("sim-main-title");
            const descEl = document.getElementById("sim-desc-text");
            const lbl1 = document.getElementById("sim-lbl-1");
            const s1 = document.getElementById("sim-slider-1");
            const sub1 = document.getElementById("sim-sub-1");
            const lbl2 = document.getElementById("sim-lbl-2");
            const s2 = document.getElementById("sim-slider-2");
            const sub2 = document.getElementById("sim-sub-2");
            const lbl3 = document.getElementById("sim-lbl-3");
            const s3 = document.getElementById("sim-slider-3");
            const sub3 = document.getElementById("sim-sub-3");
            const lblBac = document.getElementById("sim-res-lbl-bac");

            if (unitMode === 'HELSE') {
                if (titleEl) titleEl.innerText = "🏥 Døgnpleie Turnus- og Bemanningssimulator (Enhet 401 Helse)";
                if (descEl) descEl.innerText = "Simuler turnusomlegging med langvakter (HTA § 4), fraværsreduksjon og stans i innleie av vikarbyråsykepleiere for å eliminere overforbruk på art 10900/10500.";

                if (lbl1) lbl1.innerText = "Sykefraværsreduksjon (fraværskutt):";
                if (s1) { s1.min = 0; s1.max = 6; s1.step = 1; s1.value = 3; }
                if (sub1) sub1.innerHTML = "<span>0 %-p</span><span>3 %-p</span><span>6 %-p</span>";

                if (lbl2) lbl2.innerText = "Langvakter / Turnus HTA § 4 (overtidskutt):";
                if (s2) { s2.min = 0; s2.max = 35; s2.step = 5; s2.value = 20; }
                if (sub2) sub2.innerHTML = "<span>0 %</span><span>20 %</span><span>35 %</span>";

                if (lbl3) lbl3.innerText = "Stans vikarbyråsykepleiere (art 10500):";
                if (s3) { s3.min = 0; s3.max = 500000; s3.step = 50000; s3.value = 350000; }
                if (sub3) sub3.innerHTML = "<span>0 kr</span><span>250k</span><span>500k</span>";

                if (lblBac) lblBac.innerText = "Avvik mot Ramme (BAC: 14.20M)";
                loadTriageUnit('ENHET_401');
                showToast("🏥 Bemanningssimulator aktivert for Enhet 401 Helse & Mestring");
            } else if (unitMode === 'VAR') {
                if (titleEl) titleEl.innerText = "🏗️ VAR-Selvkost & KS2 Investeringssimulator (Byutvikling)";
                if (descEl) descEl.innerText = "Simuler gebyrregulering i VAR jf. Selvkostforskriften § 8, innløsning av P85 usikkerhetsbuffer på anleggskontrakter og gebyreffektivisering i byggesak.";

                if (lbl1) lbl1.innerText = "VAR gebyrjustering 2027 (utjevningsgrad):";
                if (s1) { s1.min = 0; s1.max = 10; s1.step = 1; s1.value = 4; }
                if (sub1) sub1.innerHTML = "<span>0 %</span><span>5 %</span><span>10 %</span>";

                if (lbl2) lbl2.innerText = "KS2 Investering: P85 bufferdisponering:";
                if (s2) { s2.min = 0; s2.max = 20000000; s2.step = 2000000; s2.value = 8000000; }
                if (sub2) sub2.innerHTML = "<span>0M</span><span>10M</span><span>20M</span>";

                if (lbl3) lbl3.innerText = "Byggesak: Effektivisering & gebyrinnhenting:";
                if (s3) { s3.min = 0; s3.max = 1500000; s3.step = 250000; s3.value = 750000; }
                if (sub3) sub3.innerHTML = "<span>0 kr</span><span>750k</span><span>1.5M</span>";

                if (lblBac) lblBac.innerText = "Avvik mot Ramme (BAC: 940.0M)";
                loadTriageUnit('ENHET_301');
                showToast("🏗️ VAR- og Investeringssimulator aktivert");
            } else if (unitMode === 'FINOPS') {
                if (titleEl) titleEl.innerText = "💻 FinOps Skylisens- og Konsulentsimulator (Org & Teknologi)";
                if (descEl) descEl.innerText = "Simuler sanering av inaktive SaaS-lisenser (M365/Visma), konvertering av eksterne IT-konsulenter (art 11950) til faste stillinger og RPA-automatisering.";

                if (lbl1) lbl1.innerText = "SaaS lisenssanering (inaktive M365 kontoer):";
                if (s1) { s1.min = 0; s1.max = 100; s1.step = 10; s1.value = 40; }
                if (sub1) sub1.innerHTML = "<span>0</span><span>50</span><span>100 lisenser</span>";

                if (lbl2) lbl2.innerText = "Konsulentkutt -> Faste IT-stillinger:";
                if (s2) { s2.min = 0; s2.max = 4; s2.step = 1; s2.value = 2; }
                if (sub2) sub2.innerHTML = "<span>0</span><span>2</span><span>4 stillinger</span>";

                if (lbl3) lbl3.innerText = "Automatisering & RPA-driftsgevinster:";
                if (s3) { s3.min = 0; s3.max = 800000; s3.step = 100000; s3.value = 400000; }
                if (sub3) sub3.innerHTML = "<span>0 kr</span><span>400k</span><span>800k</span>";

                if (lblBac) lblBac.innerText = "Avvik mot Ramme (BAC: 460.0M)";
                loadTriageUnit('ENHET_501');
                showToast("💻 FinOps & Konsulentsimulator aktivert");
            } else if (unitMode === 'FINANS') {
                if (titleEl) titleEl.innerText = "⚖️ Finansforvaltning & Renterisikosimulator (Konsern 7.25 Mrd)";
                if (descEl) descEl.innerText = "Simuler renteendringer i NIBOR, økning i fastrentesikringsgrad på 7,25 mrd lånegjeld og vern av kommunens disposisjonsfond mot handlingsregelen (6.0 %).";

                if (lbl1) lbl1.innerText = "Rentesikringsgrad (andel fastrente):";
                if (s1) { s1.min = 40; s1.max = 90; s1.step = 5; s1.value = 65; }
                if (sub1) sub1.innerHTML = "<span>40 %</span><span>65 %</span><span>90 %</span>";

                if (lbl2) lbl2.innerText = "NIBOR renteendring (stress-scenario):";
                if (s2) { s2.min = -100; s2.max = 200; s2.step = 25; s2.value = 50; }
                if (sub2) sub2.innerHTML = "<span>-1.00 %</span><span>0.00 %</span><span>+2.00 %</span>";

                if (lbl3) lbl3.innerText = "Disposisjonsfond overføring / buffervern:";
                if (s3) { s3.min = 0; s3.max = 50000000; s3.step = 5000000; s3.value = 20000000; }
                if (sub3) sub3.innerHTML = "<span>0M</span><span>25M</span><span>50M</span>";

                if (lblBac) lblBac.innerText = "Avvik mot Konsernramme (BAC: 7.25 Mrd)";
                loadTriageUnit('KONSERN');
                showToast("⚖️ Renterisiko- og Finanssimulator aktivert");
            } else {
                // SKOLE (Standard Enhet 202)
                if (titleEl) titleEl.innerText = "🏫 Interaktiv Tiltakssimulator (Hva-hvis EAC for Enhet 202 Skole)";
                if (descEl) descEl.innerText = "Simuler strakstiltak (innleiekutt, NAV-refusjoner og faste ansettelser) for å se direkte effekt på årsavslutning (EAC) og budsjettbalanse jf. Kommuneloven § 14-5.";

                if (lbl1) lbl1.innerText = "Vikarreduksjon (innleiekutt):";
                if (s1) { s1.min = 0; s1.max = 60; s1.step = 5; s1.value = 20; }
                if (sub1) sub1.innerHTML = "<span>0 %</span><span>30 %</span><span>60 %</span>";

                if (lbl2) lbl2.innerText = "NAV-refusjoner innfridd (art 1600):";
                if (s2) { s2.min = 0; s2.max = 410000; s2.step = 50000; s2.value = 410000; }
                if (sub2) sub2.innerHTML = "<span>0 kr</span><span>200k</span><span>410k</span>";

                if (lbl3) lbl3.innerText = "Faste stillinger (erstatter vikar):";
                if (s3) { s3.min = 0; s3.max = 4; s3.step = 1; s3.value = 2; }
                if (sub3) sub3.innerHTML = "<span>0</span><span>2</span><span>4</span>";

                if (lblBac) lblBac.innerText = "Avvik mot Ramme (BAC: 50.34M)";
                loadTriageUnit('ENHET_202');
                showToast("🏫 Tiltakssimulator aktivert for Enhet 202 Skole");
            }
            runTiltakSimulation();
        }

        function runTiltakSimulation() {
            const s1 = document.getElementById("sim-slider-1");
            const s2 = document.getElementById("sim-slider-2");
            const s3 = document.getElementById("sim-slider-3");
            if (!s1 || !s2 || !s3) return;

            const val1 = parseInt(s1.value, 10);
            const val2 = parseInt(s2.value, 10);
            const val3 = parseInt(s3.value, 10);

            const v1El = document.getElementById("sim-val-1");
            const v2El = document.getElementById("sim-val-2");
            const v3El = document.getElementById("sim-val-3");
            const eacEl = document.getElementById("sim-eac-result");
            const varEl = document.getElementById("sim-var-result");
            const badgeEl = document.getElementById("sim-status-badge");

            if (currentSimulatorUnit === 'HELSE') {
                if (v1El) v1El.innerText = `${val1} %-poeng`;
                if (v2El) v2El.innerText = `${val2} %`;
                if (v3El) v3El.innerText = `${val3.toLocaleString("no-NO")} NOK`;

                const bac = 14200000;
                const eacBase = 15300000;

                const fravaerBesparelse = val1 * 75000;
                const overtidBesparelse = 1800000 * (val2 / 100);
                const byraBesparelse = val3;

                const totalTiltak = fravaerBesparelse + overtidBesparelse + byraBesparelse;
                const nyEac = Math.round(eacBase - totalTiltak);
                const nyttAvvikNok = nyEac - bac;
                const nyttAvvikPct = ((nyttAvvikNok / bac) * 100).toFixed(2);

                if (eacEl) eacEl.innerText = `${nyEac.toLocaleString("no-NO")} NOK`;
                if (varEl) {
                    const sign = nyttAvvikNok >= 0 ? "+" : "";
                    varEl.innerText = `${sign}${nyttAvvikNok.toLocaleString("no-NO")} NOK (${sign}${nyttAvvikPct} %)`;
                    varEl.style.color = nyttAvvikPct > 2.0 ? "var(--alert-red)" : "var(--navy-dark)";
                }
                if (badgeEl) {
                    if (nyttAvvikPct <= 1.5) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = "🟢 DEKKES INNEN SEKTORRAMME (HTA § 4 godkjent)";
                    } else if (nyttAvvikPct <= 2.0) {
                        badgeEl.style.background = "#fef9c3";
                        badgeEl.style.color = "#a16207";
                        badgeEl.innerText = "🟡 AKSEPTABELT (Innenfor 2.0 % terskel)";
                    } else {
                        badgeEl.style.background = "var(--alert-red-bg)";
                        badgeEl.style.color = "var(--alert-red)";
                        badgeEl.innerText = `🔴 OVER SKJØNNSTERSKEL (${nyttAvvikPct} % > 2.0 %)`;
                    }
                }
            } else if (currentSimulatorUnit === 'VAR') {
                if (v1El) v1El.innerText = `${val1} %`;
                if (v2El) v2El.innerText = `${(val2 / 1000000).toFixed(1)} MNOK`;
                if (v3El) v3El.innerText = `${val3.toLocaleString("no-NO")} NOK`;

                const bac = 940000000;
                const eacBase = 948500000; // +8.5M YTD

                const gebyrEffekt = val1 * 3800000;
                const bufferEffekt = val2;
                const byggesakEffekt = val3;

                const totalTiltak = gebyrEffekt + bufferEffekt + byggesakEffekt;
                const nyEac = Math.round(eacBase - totalTiltak);
                const nyttAvvikNok = nyEac - bac;
                const nyttAvvikPct = ((nyttAvvikNok / bac) * 100).toFixed(2);

                if (eacEl) eacEl.innerText = `${nyEac.toLocaleString("no-NO")} NOK`;
                if (varEl) {
                    const sign = nyttAvvikNok >= 0 ? "+" : "";
                    varEl.innerText = `${sign}${nyttAvvikNok.toLocaleString("no-NO")} NOK (${sign}${nyttAvvikPct} %)`;
                    varEl.style.color = nyttAvvikNok <= 0 ? "var(--success-green)" : "var(--navy-dark)";
                }
                if (badgeEl) {
                    if (nyttAvvikNok <= 0) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = "🟢 SELVKOSTFOND I OVERVEKT (§ 8 balanse)";
                    } else if (nyttAvvikNok <= 4000000) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = "🟢 DEKKES AV SELVKOSTFOND (5-års utjevning)";
                    } else {
                        badgeEl.style.background = "#fef9c3";
                        badgeEl.style.color = "#a16207";
                        badgeEl.innerText = "🟡 GEBYRREGULATIV-JUSTERING PÅKREVD";
                    }
                }
            } else if (currentSimulatorUnit === 'FINOPS') {
                if (v1El) v1El.innerText = `${val1} lisenser`;
                if (v2El) v2El.innerText = `${val2} ${val2 === 1 ? 'stilling' : 'stillinger'}`;
                if (v3El) v3El.innerText = `${val3.toLocaleString("no-NO")} NOK`;

                const bac = 460000000;
                const eacBase = 463200000; // +3.2M konsulentmerforbruk

                const lisensBesparelse = val1 * 10500;
                const konsulentBesparelse = val2 * 900000;
                const rpaBesparelse = val3;

                const totalTiltak = lisensBesparelse + konsulentBesparelse + rpaBesparelse;
                const nyEac = Math.round(eacBase - totalTiltak);
                const nyttAvvikNok = nyEac - bac;
                const nyttAvvikPct = ((nyttAvvikNok / bac) * 100).toFixed(2);

                if (eacEl) eacEl.innerText = `${nyEac.toLocaleString("no-NO")} NOK`;
                if (varEl) {
                    const sign = nyttAvvikNok >= 0 ? "+" : "";
                    varEl.innerText = `${sign}${nyttAvvikNok.toLocaleString("no-NO")} NOK (${sign}${nyttAvvikPct} %)`;
                    varEl.style.color = nyttAvvikPct <= 0.5 ? "var(--success-green)" : "var(--navy-dark)";
                }
                if (badgeEl) {
                    if (nyttAvvikPct <= 0.3) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = "🟢 FINOPS-GEVINST REALISERT (Skykontroll)";
                    } else {
                        badgeEl.style.background = "#fef9c3";
                        badgeEl.style.color = "#a16207";
                        badgeEl.innerText = "🟡 KONSULENTPRESS REDUSERT";
                    }
                }
            } else if (currentSimulatorUnit === 'FINANS') {
                const niborDecimal = (val2 / 100);
                const niborSign = val2 >= 0 ? "+" : "";
                if (v1El) v1El.innerText = `${val1} %`;
                if (v2El) v2El.innerText = `${niborSign}${niborDecimal.toFixed(2)} %-p`;
                if (v3El) v3El.innerText = `${(val3 / 1000000).toFixed(0)} MNOK`;

                const bac = 7250000000;
                // Renteøkning på den usikrede flytende andelen av 7.25 mrd
                const usikretGjeld = bac * (1 - (val1 / 100));
                const renteOkningNok = usikretGjeld * (niborDecimal / 100);
                const fondTrekk = val3;

                const nyEac = Math.round(bac + renteOkningNok - fondTrekk);
                const nyttAvvikNok = nyEac - bac;
                const nyttAvvikPct = ((nyttAvvikNok / bac) * 100).toFixed(2);

                // Disposisjonsfond andel beregning (Startsaldo 485M)
                const restFond = 485000000 - Math.max(0, nyttAvvikNok);
                const fondPct = ((restFond / bac) * 100).toFixed(2);

                if (eacEl) eacEl.innerText = `${nyEac.toLocaleString("no-NO")} NOK`;
                if (varEl) {
                    const sign = nyttAvvikNok >= 0 ? "+" : "";
                    varEl.innerText = `${sign}${nyttAvvikNok.toLocaleString("no-NO")} NOK (${sign}${nyttAvvikPct} %)`;
                    varEl.style.color = fondPct >= 6.0 ? "var(--success-green)" : "var(--alert-red)";
                }
                if (badgeEl) {
                    if (fondPct >= 6.0) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = `🟢 BUFFER INTAKT: Disposisjonsfond ${fondPct} % (Krav: 6.0 %)`;
                    } else {
                        badgeEl.style.background = "var(--alert-red-bg)";
                        badgeEl.style.color = "var(--alert-red)";
                        badgeEl.innerText = `🔴 HANDLINGSREGEL BRUTT: Disposisjonsfond ${fondPct} % < 6.0 %`;
                    }
                }
            } else {
                // SKOLE
                if (v1El) v1El.innerText = `${val1} %`;
                if (v2El) v2El.innerText = `${val2.toLocaleString("no-NO")} NOK`;
                if (v3El) v3El.innerText = `${val3} ${val3 === 1 ? 'stilling' : 'stillinger'}`;

                const bac = 50339572;
                const eacBase = 52189572;
                const vikarGjenstaende = 2200000;

                const vikarBesparelse = vikarGjenstaende * (val1 / 100);
                const fastNettoEffekt = val3 * 90000;

                const totalTiltaksEffekt = vikarBesparelse + val2 + fastNettoEffekt;
                const nyEac = Math.round(eacBase - totalTiltaksEffekt);
                const nyttAvvikNok = nyEac - bac;
                const nyttAvvikPct = ((nyttAvvikNok / bac) * 100).toFixed(2);

                if (eacEl) eacEl.innerText = `${nyEac.toLocaleString("no-NO")} NOK`;
                if (varEl) {
                    const sign = nyttAvvikNok >= 0 ? "+" : "";
                    varEl.innerText = `${sign}${nyttAvvikNok.toLocaleString("no-NO")} NOK (${sign}${nyttAvvikPct} %)`;
                    varEl.style.color = nyttAvvikPct > 2.0 ? "var(--alert-red)" : "var(--navy-dark)";
                }
                if (badgeEl) {
                    if (nyttAvvikPct <= 2.0) {
                        badgeEl.style.background = "#dcfce7";
                        badgeEl.style.color = "#15803d";
                        badgeEl.innerText = "🟢 LOVLIG (< 2.0 % terskel jf. § 14-5)";
                    } else {
                        badgeEl.style.background = "var(--alert-red-bg)";
                        badgeEl.style.color = "var(--alert-red)";
                        badgeEl.innerText = `🔴 KRITISK MERFORBRUK (${nyttAvvikPct} % > 2.0 %)`;
                    }
                }
            }
        }

        function applySimulationToReport4() {
            const v1 = document.getElementById("sim-val-1") ? document.getElementById("sim-val-1").innerText : "";
            const v2 = document.getElementById("sim-val-2") ? document.getElementById("sim-val-2").innerText : "";
            const v3 = document.getElementById("sim-val-3") ? document.getElementById("sim-val-3").innerText : "";
            const varResult = document.getElementById("sim-var-result") ? document.getElementById("sim-var-result").innerText : "";

            const p3 = document.getElementById("rep4-p3");
            const p4 = document.getElementById("rep4-p4");

            if (currentSimulatorUnit === 'HELSE') {
                if (p3) {
                    p3.innerText = `A) Turnusomlegging med langvakter jf. HTA § 4 (${v2} kutt i art 10900 overtid). B) Sykefraværsreduksjon (${v1}). C) Stans i innleie av vikarbyrå (${v3}).`;
                }
                if (p4) {
                    p4.innerHTML = `Simulert årsprognose: Revidert avvik <strong>${varResult}</strong> mot ramme (Inndekkes fullt ut innen Helse og mestrings ramme).`;
                }
                showToast("✓ Helse- og turnustiltak overført til Enhet 401 saksnotat!");
            } else if (currentSimulatorUnit === 'VAR') {
                if (p3) {
                    p3.innerText = `A) VAR gebyrregulering ${v1} for 2027. B) Innløsning av P85 usikkerhetsbuffer (${v2}) på anleggskontrakter. C) Byggesaksgebyr-effektivisering (${v3}).`;
                }
                if (p4) {
                    p4.innerHTML = `Simulert årsprognose: Revidert avvik <strong>${varResult}</strong> mot ramme (Balanseres mot VAR-selvkostfond jf. § 8).`;
                }
                showToast("✓ VAR- og investeringstiltak overført til Enhet 301 saksnotat!");
            } else if (currentSimulatorUnit === 'FINOPS') {
                if (p3) {
                    p3.innerText = `A) Sanering av ${v1} inaktive SaaS-lisenser. B) Konvertering av ${v2} konsulenter til faste stillinger. C) RPA-automatisering (${v3}).`;
                }
                if (p4) {
                    p4.innerHTML = `Simulert årsprognose: Revidert avvik <strong>${varResult}</strong> mot ramme (FinOps-gevinst realisert).`;
                }
                showToast("✓ FinOps- og konsulenttiltak overført til Enhet 501 saksnotat!");
            } else if (currentSimulatorUnit === 'FINANS') {
                if (p3) {
                    p3.innerText = `A) Økning i rentesikringsgrad til ${v1} (rentebytteavtaler). B) Håndtering av NIBOR-stress (${v2}). C) Vern av disposisjonsfond (${v3}).`;
                }
                if (p4) {
                    p4.innerHTML = `Simulert årsprognose: Revidert avvik <strong>${varResult}</strong> mot ramme (Disposisjonsfond overholder 6.0 % handlingsregel).`;
                }
                showToast("✓ Konsernets finanstiltak overført til saksnotat!");
            } else {
                if (p3) {
                    p3.innerText = `A) Vikarkutt ${v1} (innleiestopp). B) Innfrielse av NAV-refusjoner (${v2}). C) ${v3} faste fagarbeidere.`;
                }
                if (p4) {
                    p4.innerHTML = `Simulert årsprognose: Revidert avvik <strong>${varResult}</strong> mot ramme (Balanse jf. § 14-5).`;
                }
                showToast("✓ Skole- og vikartiltak overført til Enhet 202 saksnotat!");
            }
        }

        // 5. Presentasjons- og Møtemodus
        function togglePresentationMode() {
            document.body.classList.toggle("presentation-mode");
            const isPres = document.body.classList.contains("presentation-mode");
            showToast(isPres ? "🖥️ Møtemodus aktivert (Trykk P eller Esc for å avslutte)" : "Møtemodus avsluttet");
        }

        // 6. Global tastaturnavigasjon (Escape, Ctrl+K, P)
        document.addEventListener("keydown", (e) => {
            const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : "";
            const isInputFocused = (activeTag === "input" || activeTag === "textarea" || activeTag === "select");

            // Ctrl + K eller Cmd + K: Åpne Command Palette
            if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                openCommandPalette();
                return;
            }

            // P (når ikke i inputfelt): Veksle Møtemodus
            if (e.key.toLowerCase() === "p" && !isInputFocused && !e.ctrlKey && !e.metaKey && !e.altKey) {
                e.preventDefault();
                togglePresentationMode();
                return;
            }

            // Escape: Lukk alle åpne overlegg
            if (e.key === "Escape") {
                closeModal();
                closeUserGuide();
                closeCommandPalette();
                if (document.body.classList.contains("presentation-mode")) {
                    document.body.classList.remove("presentation-mode");
                    showToast("Møtemodus avsluttet");
                }
                const drawer = document.getElementById("chat-drawer");
                if (drawer && drawer.classList.contains("open")) {
                    drawer.classList.remove("open");
                }
            }
        });

        // Initier sjekkliste, nøkkeltall og KOSTRA-artsavvik ved oppstart
        document.addEventListener("DOMContentLoaded", () => {
            selectWorkflowPhase(2, false);
            selectSector("ALL");
            if (typeof renderVariancesTable === 'function') renderVariancesTable("ALL");
            if (typeof renderMeetingPack === 'function') renderMeetingPack("ALL", "NIVA1");
        });
        setTimeout(() => {
            selectWorkflowPhase(2, false);
            selectSector("ALL");
            if (typeof renderVariancesTable === 'function') renderVariancesTable("ALL");
            if (typeof renderMeetingPack === 'function') renderMeetingPack("ALL", "NIVA1");
        }, 150);

    
        // Initialiser dynamisk sidebar ved oppstart
        document.addEventListener("DOMContentLoaded", () => {
            if (typeof updateSidebarSectorBadges === 'function') updateSidebarSectorBadges();
            if (typeof updateSidebarOverview === 'function') updateSidebarOverview('ALL');
        });
        // Sikre også umiddelbar oppdatering hvis DOM allerede er klar
        if (typeof updateSidebarSectorBadges === 'function') updateSidebarSectorBadges();
        if (typeof updateSidebarOverview === 'function') updateSidebarOverview('ALL');

    </script>
</body>
</html>
