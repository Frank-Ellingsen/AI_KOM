            const btn = document.getElementById("btn-batch-approve");
            const msg = document.getElementById("batch-approve-msg");
            const txt = document.getElementById("green-units-text");
            btn.disabled = true;
            btn.innerText = "✓ Godkjent";
            btn.classList.remove("btn-primary");
            btn.style.background = "var(--success-green)";
            btn.style.borderColor = "var(--success-green)";
            txt.innerHTML = "<strong>14 enheter</strong> <span style='color:var(--success-green); font-weight:700;'>BATCH-GODKJENT</span> (Ingen avvik > 2 %)";
            msg.style.display = "block";
            document.getElementById("triage-counter-badge").innerText = "14 godkjent | 2 gjenstår";
            document.getElementById("triage-counter-badge").style.borderColor = "var(--success-green)";
            document.getElementById("triage-counter-badge").style.color = "var(--success-green)";
        }

