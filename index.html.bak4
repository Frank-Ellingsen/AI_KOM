        <!-- INTERAKTIV TILTAKSSIMULATOR (MINI-EAC KALKULATOR) -->
        <div class="triage-card" id="tiltak-simulator-card" style="grid-column: 1 / -1; border-left: 3px solid var(--accent-blue); background: #ffffff;">
            <div class="section-header" style="margin-bottom: 8px;">
                <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <span id="sim-main-title">🎛️ Interaktiv Tiltakssimulator (Hva-hvis EAC)</span>
                    <div style="display:flex; gap:6px; flex-wrap:wrap;">
                        <button class="btn btn-sm btn-primary" id="sim-tab-skole" onclick="switchSimulatorUnit('SKOLE')" style="font-size:11px; padding:3px 8px;">
                            🏫 Skole (Enhet 202)
                        </button>
                        <button class="btn btn-sm" id="sim-tab-helse" onclick="switchSimulatorUnit('HELSE')" style="font-size:11px; padding:3px 8px; background:#f1f5f9; border-color:#cbd5e1; color:var(--text-primary);">
                            🏥 Helse (Enhet 401)
                        </button>
                        <button class="btn btn-sm" id="sim-tab-var" onclick="switchSimulatorUnit('VAR')" style="font-size:11px; padding:3px 8px; background:#f1f5f9; border-color:#cbd5e1; color:var(--text-primary);">
                            🏗️ Byutvikling (VAR & KS2)
                        </button>
                        <button class="btn btn-sm" id="sim-tab-finops" onclick="switchSimulatorUnit('FINOPS')" style="font-size:11px; padding:3px 8px; background:#f1f5f9; border-color:#cbd5e1; color:var(--text-primary);">
                            💻 Org/Tek (FinOps)
                        </button>
                        <button class="btn btn-sm" id="sim-tab-finans" onclick="switchSimulatorUnit('FINANS')" style="font-size:11px; padding:3px 8px; background:#f1f5f9; border-color:#cbd5e1; color:var(--text-primary);">
                            ⚖️ Konsern (Rente & Fond)
                        </button>
                    </div>
                </div>
                <span class="status-badge" style="background:#e0f2fe; color:#0369a1; font-weight:700;">Beslutningsstøtte</span>
            </div>
            <p style="font-size: 11.5px; color: var(--text-secondary); margin-bottom: 12px;" id="sim-desc-text">
                Simuler strakstiltak (innleiekutt, NAV-refusjoner og faste ansettelser) for å se direkte effekt på årsavslutning (EAC) og budsjettbalanse jf. Kommuneloven § 14-5.
            </p>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-bottom: 12px;" id="sim-sliders-container">
                <div class="sim-control-group">
                    <div style="font-size:11px; font-weight:700; color:var(--navy-dark); display:flex; justify-content:space-between;">
                        <span id="sim-lbl-1">Vikarreduksjon (innleiekutt):</span>
                        <span id="sim-val-1" style="font-family:var(--font-mono); font-weight:700; color:var(--accent-blue);">20 %</span>
                    </div>
                    <input type="range" id="sim-slider-1" min="0" max="60" value="20" step="5" oninput="runTiltakSimulation()" style="width:100%; margin-top:6px;">
                    <div style="font-size:10px; color:var(--text-muted); display:flex; justify-content:space-between; margin-top:2px;" id="sim-sub-1">
                        <span>0 %</span><span>30 %</span><span>60 %</span>
                    </div>
                </div>
                <div class="sim-control-group">
                    <div style="font-size:11px; font-weight:700; color:var(--navy-dark); display:flex; justify-content:space-between;">
                        <span id="sim-lbl-2">NAV-refusjoner innfridd (art 1600):</span>
                        <span id="sim-val-2" style="font-family:var(--font-mono); font-weight:700; color:var(--success-green);">410 000 NOK</span>
                    </div>
                    <input type="range" id="sim-slider-2" min="0" max="410000" value="410000" step="50000" oninput="runTiltakSimulation()" style="width:100%; margin-top:6px;">
                    <div style="font-size:10px; color:var(--text-muted); display:flex; justify-content:space-between; margin-top:2px;" id="sim-sub-2">
                        <span>0 kr</span><span>200k</span><span>410k</span>
                    </div>
                </div>
                <div class="sim-control-group">
                    <div style="font-size:11px; font-weight:700; color:var(--navy-dark); display:flex; justify-content:space-between;">
                        <span id="sim-lbl-3">Faste stillinger (erstatter vikar):</span>
                        <span id="sim-val-3" style="font-family:var(--font-mono); font-weight:700; color:var(--navy-dark);">2 stillinger</span>
                    </div>
                    <input type="range" id="sim-slider-3" min="0" max="4" value="2" step="1" oninput="runTiltakSimulation()" style="width:100%; margin-top:6px;">
                    <div style="font-size:10px; color:var(--text-muted); display:flex; justify-content:space-between; margin-top:2px;" id="sim-sub-3">
                        <span>0</span><span>2</span><span>4</span>
                    </div>
                </div>
            </div>
            <div style="background:#f8fafc; border:1px solid var(--border-light); padding:10px 14px; border-radius:3px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                <div>
                    <div style="font-size:10px; color:var(--text-secondary); text-transform:uppercase; font-weight:700;" id="sim-res-lbl-eac">Simulert Årseffekt (EAC)</div>
                    <div style="font-size:15px; font-family:var(--font-mono); font-weight:700; color:var(--navy-dark);" id="sim-eac-result">50 939 572 NOK</div>
                </div>
                <div>
                    <div style="font-size:10px; color:var(--text-secondary); text-transform:uppercase; font-weight:700;" id="sim-res-lbl-bac">Avvik mot Ramme (BAC: 50.34M)</div>
                    <div style="font-size:15px; font-family:var(--font-mono); font-weight:700;" id="sim-var-result">+600 000 NOK (+1.19 %)</div>
                </div>
                <div>
                    <div style="font-size:10px; color:var(--text-secondary); text-transform:uppercase; font-weight:700;">Status</div>
                    <span class="status-badge" id="sim-status-badge" style="background:#dcfce7; color:#15803d; font-size:11px; font-weight:700;">
                        🟢 LOVLIG (&lt; 2.0 % terskel)
                    </span>
                </div>
                <button class="btn btn-sm btn-primary" onclick="applySimulationToReport4()" title="Overfør de simulerte tallene til 4-punkts notatet">
                    Overfør til Saksnotat ↵
                </button>
            </div>
        </div>
    </div>

    <!-- =======================================================================
         5C. MÅNEDLIG MØTERAPPORTERING & NIVÅSTYRING (NIVÅ 1, 2, 3)
         ======================================================================= -->
    <section class="workflow-section" id="mote-rapportering-seksjon">
        <div class="section-header">
            <span>👥 Månedsmøter & Nivårapportering — Økonomirådgiverens Oppfølging</span>
            <span class="status-badge" id="meeting-header-badge">Månedssyklus M10 (Oktober) | Port 9 HITL</span>
        </div>
        <p style="font-size: 12.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.55;">
            Hver måned følger økonomirådgiveren opp hver budsjettansvarlig med skreddersydd status, kritiske avvik og handlingsplan for å sikre budsjettbalanse ved årets slutt (EOY per 31.12) jf. <strong>Kommuneloven § 14-5</strong>. Rapporteringen er organisert i 3 styringsnivåer tilpasset beslutningsmyndighet og lovpålagte rammer.
        </p>

        <!-- Nivåvelger Faner (Nivå 1, Nivå 2, Nivå 3) -->
        <div class="level-pills-bar" id="level-pills-bar">
            <button class="level-pill-btn active" id="btn-lvl-niva1" onclick="switchMeetingLevel('NIVA1')">
                <span>👤 Nivå 1: Avdelings- / Seksjonsleder</span>
                <span class="level-badge">Operativ Enhet</span>
            </button>
            <button class="level-pill-btn" id="btn-lvl-niva2" onclick="switchMeetingLevel('NIVA2')">
                <span>👥 Nivå 2: Kommunalsjef</span>
                <span class="level-badge">Taktisk Sektor</span>
            </button>
            <button class="level-pill-btn" id="btn-lvl-niva3" onclick="switchMeetingLevel('NIVA3')">
                <span>🏛️ Nivå 3: Kommunaldirektør</span>
                <span class="level-badge">Toppledelse</span>
            </button>
        </div>

        <!-- Møtedetaljer Hovedkort (Innhold injiseres dynamisk) -->
        <div class="meeting-card" id="meeting-main-card">
            <div style="text-align: center; padding: 24px; color: var(--text-secondary);">
                Laster møtepakke for valgt nivå og sektor...
            </div>
        </div>
    </section>

    <!-- =======================================================================
         6. OPERATIV SAKSBEHANDLINGSFLYT & STAGE-GATE SLØYFE
         ======================================================================= -->
    <section class="workflow-section" id="saksflyt">
        <div class="section-header">
            <span>🔄 Operativ Saksbehandlingsflyt & Stage-Gate Sløyfe (Trinn 1–6)</span>
            <span class="status-badge">Kommuneloven § 14-5 & EU AI Act Art. 14</span>
        </div>
        <p style="font-size: 12px; color: var(--text-secondary); margin-bottom: 12px;">
            Standardisert arbeidsflyt for saksbehandling, partssamarbeid og sign-off fra oppdaget avvik til politisk vedtak i Formannskapet/Bystyret.
        </p>

        <div class="stepper-grid">
            <div class="step-card active-step" onclick="selectFlowStep(1)">
                <div class="step-num">Trinn 1</div>
                <div class="step-title">🚨 Avviksdeteksjon</div>
                <div class="step-desc">Automatisk Z-score screening av Visma ERP mot Framsikt rammer (60-90 dager før T2).</div>
            </div>
            <div class="step-card" onclick="selectFlowStep(2)">
                <div class="step-num">Trinn 2</div>
                <div class="step-title">🤖 Glass-Box RAG</div>
                <div class="step-desc">Årsaksforklaring med eksplisitt paragrafsitering (§ 14-5, § 14-6, KOSTRA-veileder).</div>
            </div>
            <div class="step-card" onclick="selectFlowStep(3)">
                <div class="step-num">Trinn 3</div>
                <div class="step-title">🤝 HTA § 4 Drøfting</div>
                <div class="step-desc">Obligatorisk partssamarbeid med tillitsvalgte ved turnus- eller vikartiltak.</div>
            </div>
            <div class="step-card" onclick="selectFlowStep(4)">
                <div class="step-num">Trinn 4</div>
                <div class="step-title">👤 HITL Overprøving</div>
                <div class="step-desc">Controller godkjenner (APPROVED), modifiserer eller avviser AI-anbefaling.</div>
            </div>
            <div class="step-card" onclick="selectFlowStep(5)">
                <div class="step-num">Trinn 5</div>
                <div class="step-title">🔒 SHA-256 Stempel</div>
                <div class="step-desc">Uforanderlig kryptografisk forsegling i Audit_AI_Actions for Kommunerevisjonen.</div>
            </div>
            <div class="step-card" onclick="selectFlowStep(6)">
                <div class="step-num">Trinn 6</div>
                <div class="step-title">🏛️ Politisk Vedtak</div>
                <div class="step-desc">Ferdigstillelse av saksfremlegg til Formannskapet og overføring til Public360.</div>
            </div>
        </div>

        <!-- INTERAKTIV SAKSGENERATOR -->
        <div class="saksgenerator-box">
            <div style="font-weight: 700; font-size: 12px; color: var(--navy-dark); margin-bottom: 8px;">
                ⚡ Interaktiv Saksgenerator & Notatbygger (Klikk og produser forvaltningsnotat)
            </div>
            <div class="generator-grid">
                <div class="form-group">
                    <label>Velg Enhet / Sektor</label>
                    <select id="gen-enhet" class="form-select" onchange="updateGeneratedNote()">
